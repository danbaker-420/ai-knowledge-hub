<script>
    let renderer, camera, scene, cubes = [];
    const textureLoader = new THREE.TextureLoader();
    let backgroundPlane;
    
    const backgroundImage = 'https://placehold.co/1200x600/FF5200/FF5200?text=Procore+Orange';
    const patentDiagramUrl = 'https://placehold.co/2000x240/1A1A1A/1A1A1A?text=ABSTRACT+CONSTRUCTION+PLAN';

    function getBannerHeight() {
        const wrapper = document.getElementById('banner-canvas-wrapper');
        if (wrapper && wrapper.style.height) {
            return parseFloat(wrapper.style.height);
        }
        return 350;
    }

    function updateCanvasSize() {
        const canvas = document.getElementById('carousel-canvas');
        if (!canvas) return;

        const newWidth = canvas.parentElement ? canvas.parentElement.clientWidth : window.innerWidth;
        const newHeight = getBannerHeight();
        
        if (renderer && camera) {
            renderer.setSize(newWidth, newHeight);
            camera.aspect = newWidth / newHeight;
            camera.updateProjectionMatrix();
        }
    }
    
    function initCarousel() {
        const canvas = document.getElementById('carousel-canvas');
        if (!canvas) return;

        const initialHeight = getBannerHeight();

        scene = new THREE.Scene();
        scene.background = new THREE.Color(0xFF5200);

        camera = new THREE.PerspectiveCamera(75, canvas.clientWidth / initialHeight, 0.1, 1000);
        camera.position.z = 5.5;

        renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true, alpha: true });
        
        updateCanvasSize();

        const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
        scene.add(ambientLight);
        const directionalLight = new THREE.DirectionalLight(0xffffff, 0.8);
        directionalLight.position.set(0, 5, 5);
        scene.add(directionalLight);
        
        
        // 1. Set Primary Background to Texture (Procore Orange)
        textureLoader.load(backgroundImage,
            function(texture) {
                texture.colorSpace = THREE.SRGBColorSpace;
                scene.background = texture;
            },
            undefined,
            function(err) {
                console.error('Error loading background image:', err);
                scene.background = new THREE.Color(0xFF5200);
            }
        );
        
        // 2. Watermark Layer (Abstract pattern in light gray for contrast)
        textureLoader.load(patentDiagramUrl,
            function(texture) {
                texture.colorSpace = THREE.SRGBColorSpace;
                
                const backgroundGeometry = new THREE.PlaneGeometry(20, 10);
                const backgroundMaterial = new THREE.MeshBasicMaterial({
                    map: texture,
                    transparent: true,
                    opacity: 0.3,
                    side: THREE.DoubleSide
                });

                backgroundPlane = new THREE.Mesh(backgroundGeometry, backgroundMaterial);
                backgroundPlane.position.z = -1;
                backgroundPlane.rotation.z = -Math.PI * 0.05;
                backgroundPlane.position.y = -1;
                scene.add(backgroundPlane);
            },
            undefined,
            function(err) {
                console.error('Error loading patent diagram texture:', err);
            }
        );

        const excitingAreas = [
            { title: "Legal Tech", color: 0xff5200, position: -1.8 },
            { title: "Process", color: 0x000000, position: 0.0 },
            { title: "Strategy", color: 0xff5200, position: 1.8 }
        ];

        const width = 2.0, height = 3.0, depth = 0.8, segments = 10;

        excitingAreas.forEach((area) => {
            const cubeGeometry = new THREE.BoxGeometry(width, height, depth, segments, segments, segments);
            cubeGeometry.computeVertexNormals();
            
            const materialColor = area.color === 0x000000 ? 0x222222 : 0xcc4400;
            const material = new THREE.MeshPhongMaterial({
                color: materialColor,
                emissive: materialColor,
                emissiveIntensity: 0.2,
                shininess: 80,
                specular: 0xcccccc
            });
            
            const cube = new THREE.Mesh(cubeGeometry, material);
            
            cube.position.x = area.position;
            cube.userData.rotationSpeed = 0.01;
            cubes.push(cube);
            scene.add(cube);
        });
    }

    let animationFrameId;

    function animate() {
        animationFrameId = requestAnimationFrame(animate);

        if (backgroundPlane) {
            backgroundPlane.rotation.z += 0.0005;
            backgroundPlane.position.x = Math.sin(Date.now() * 0.0001) * 0.5;
        }
        
        cubes.forEach(cube => {
            cube.rotation.y += cube.userData.rotationSpeed * 0.5;
            cube.rotation.x += cube.userData.rotationSpeed / 4;
            cube.rotation.z += cube.userData.rotationSpeed / 8;
            
            cube.updateMatrixWorld(true);
            
            const scaleFactor = 1 + Math.sin(Date.now() * 0.001 * cube.userData.rotationSpeed * 20) * 0.03;
            cube.scale.x = cube.scale.y = cube.scale.z = scaleFactor;
        });

        if (renderer) {
            renderer.render(scene, camera);
        }
    }

    function onWindowResize() {
        updateCanvasSize();
    }

    /**
     * Closes all standard header dropdown menus and mobile menu.
     * Optionally excludes one toggle ID.
     */
    function toggleDropdownCleanup(excludeToggleId = null) {
        // 1. Close standard dropdowns
        document.querySelectorAll('.header-dropdown-menu').forEach(menu => {
            menu.classList.add('hidden');
        });
        
        // 2. Reset primary dropdown icons (except the one being clicked)
        document.querySelectorAll('.nav-item-button').forEach(button => {
            if (button.id !== excludeToggleId) {
                const icon = button.querySelector('.dropdown-icon');
                if (icon) icon.style.transform = 'rotate(0deg)';
            }
        });
        
        // 3. Reset nested menus/icons (specific for Blogs & Podcasts and AI on the Core)
        document.querySelectorAll('.nested-dropdown-content').forEach(m => m.classList.add('hidden'));
        document.querySelectorAll('.dropdown-icon-nested').forEach(icon => icon.style.transform = 'rotate(0deg)');
        
        // 4. Close the mobile menu if open (unless the mobile toggle button itself is being clicked)
        const mobileMenu = document.getElementById('mobile-menu');
        if (mobileMenu && mobileMenu.classList.contains('open') && excludeToggleId !== 'mobile-menu-toggle') {
             mobileMenu.classList.remove('open');
             document.getElementById('menu-open-icon').classList.remove('hidden');
             document.getElementById('menu-close-icon').classList.add('hidden');
             mobileMenu.setAttribute('aria-expanded', 'false');
        }
    }

    /**
     * Toggles the visibility of a specified dropdown menu (used for header nav and mobile dropdowns).
     */
    function toggleDropdown(menuId, button) {
        const menu = document.getElementById(menuId);
        // Ensure we are targeting the primary dropdown icon (dropdown-icon)
        const icon = button.querySelector('.dropdown-icon'); 
        
        const wasOpen = !menu.classList.contains('hidden');
        
        toggleDropdownCleanup(button.id); 

        if (wasOpen) {
            menu.classList.add('hidden');
            if (icon) icon.style.transform = 'rotate(0deg)';
        } else {
            menu.classList.remove('hidden');
            if (icon) icon.style.transform = 'rotate(180deg)';
        }
    }

    /**
     * Toggles the mobile menu for small screens.
     */
    function toggleMobileMenu() {
        const mobileMenu = document.getElementById('mobile-menu');
        const openIcon = document.getElementById('menu-open-icon');
        const closeIcon = document.getElementById('menu-close-icon');

        const isOpen = mobileMenu.classList.toggle('open');
        
        openIcon.classList.toggle('hidden', isOpen);
        closeIcon.classList.toggle('hidden', !isOpen);

        mobileMenu.setAttribute('aria-expanded', isOpen);

        if (!isOpen) {
            // Also close all mobile dropdown sub-menus
            document.querySelectorAll('.bg-gray-800[id^="mobile-dropdown-menu-"]').forEach(subDropdown => {
                subDropdown.classList.add('hidden');
            });
        }
    }
    
    /**
     * Toggles the visibility of a collapsible section.
     */
    function toggleCollapsible(contentId, button) {
        const content = document.getElementById(contentId);
        if (content) {
            const isOpening = !content.classList.contains('open');
            
            content.classList.toggle('open');
            button.classList.toggle('open');
            button.setAttribute('aria-expanded', isOpening);
        }
    }

    /**
     * Toggles the visibility of a nested explore menu (Level 2).
     */
    function toggleExploreSubDropdown(menuId, button) {
        const menu = document.getElementById(menuId);
        // Find the icon SVG specifically inside this button with class 'dropdown-icon-nested'
        const icon = button.querySelector('.dropdown-icon-nested'); 
        
        // Find all other level 2 menus in the same container (e.g., inside dropdown-menu-1 or header-explore-menu-1)
        const parentDropdown = button.closest('.header-dropdown-menu');
        if (!parentDropdown) return;

        const allLevel2Menus = parentDropdown.querySelectorAll('.nested-dropdown-content');
        const allLevel2Buttons = parentDropdown.querySelectorAll('.nested-dropdown-button');

        // Close all other menus and reset their icons
        allLevel2Menus.forEach(m => {
            if (m.id !== menuId) {
                m.classList.add('hidden');
            }
        });
        allLevel2Buttons.forEach(btn => {
            const btnIcon = btn.querySelector('.dropdown-icon-nested');
            if (btn.id !== button.id && btnIcon) {
                btnIcon.style.transform = 'rotate(0deg)'; 
                btn.classList.remove('open');
            }
        });

        // Toggle current menu/icon
        const isHidden = menu.classList.toggle('hidden');
        button.classList.toggle('open', !isHidden);
        
        // Determine if we are opening to the left (only happens for Blogs & Podcasts, which is header-explore-menu-1)
        const isOpeningLeft = button.closest('#header-explore-menu-1') !== null; 

        if (!isHidden) {
            // If opening left (Blogs & Podcasts), rotate 180deg (right arrow -> left arrow)
            if (isOpeningLeft) {
                if(icon) icon.style.transform = 'rotate(180deg)'; 
            } else {
                // If opening right (Enterprise AI submenu), rotate 90deg (right arrow -> down arrow)
                if(icon) icon.style.transform = 'rotate(90deg)'; 
            }
        } else {
            if(icon) icon.style.transform = 'rotate(0deg)'; 
        }
    }
    
    /**
     * Scrolls to a specific section and handles menu cleanup.
     */
    function scrollToSection(targetId, event = null, doScroll = true) {
        if (event && typeof event.preventDefault === 'function') {
            event.preventDefault();
        }
        
        toggleDropdownCleanup();
        const mobileMenu = document.getElementById('mobile-menu');
        if (mobileMenu && mobileMenu.classList.contains('open')) {
            toggleMobileMenu();
        }

        if (doScroll) {
            const targetElement = document.getElementById(targetId);
            if (targetElement) {
                targetElement.scrollIntoView({
                    behavior: 'smooth',
                    block: 'start'
                });
            } else if (targetId === 'top-of-page') {
                window.scrollTo({
                    top: 0,
                    behavior: 'smooth'
                });
            }
        }
    }
    

    /**
     * Toggles between content tabs (workstreams, trends, tools/trials).
     */
    function toggleTab(contentId, button, doScroll = false, event = null) {
        
        if (event && typeof event.preventDefault === 'function') {
            event.preventDefault();
        }
        
        const parentSection = button.closest('section');
        if (!parentSection) return;
        const parentSectionId = parentSection.id;

        document.querySelectorAll(`#${parentSectionId} .tab-content`).forEach(content => {
            content.style.display = 'none';
        });

        document.querySelectorAll(`#${parentSectionId} .tab-button`).forEach(btn => {
            btn.classList.remove('active', 'text-white');
            btn.classList.add('text-gray-400');
            btn.setAttribute('aria-selected', 'false');
        });

        const selectedContent = document.getElementById(contentId);
        if (selectedContent) {
            selectedContent.style.display = 'block';
            button.classList.add('active', 'text-white');
            button.classList.remove('text-gray-400');
            button.setAttribute('aria-selected', 'true');
        }
    }
    
    /**
     * Toggles between content tabs for the INNER tab system.
     */
    function toggleInnerTab(contentId, button) {
        const parent = button.closest('.bg-white'); // Find the closest containing box
        if (!parent) return;

        // Hide all inner tab content and deactivate all buttons within this container
        parent.querySelectorAll('.inner-tab-content').forEach(content => {
            content.style.display = 'none';
        });
        parent.querySelectorAll('.inner-tab-button').forEach(btn => {
            btn.classList.remove('active');
        });

        // Show the selected content and activate the clicked button
        const selectedContent = document.getElementById(contentId);
        if (selectedContent) {
            selectedContent.style.display = 'block';
            button.classList.add('active');
        }
    }
    
    /**
     * Toggles between content tabs for the custom dark Awards inner tab system.
     */
    function toggleAwardInnerTab(contentId, button) {
        const parent = button.closest('.bg-gray-900'); // Find the closest containing box
        if (!parent) return;

        // Hide all inner tab content and deactivate all buttons within this container
        parent.querySelectorAll('.award-tab-content').forEach(content => {
            content.style.display = 'none';
        });
        parent.querySelectorAll('.award-tab-button').forEach(btn => {
            btn.classList.remove('active-award-tab', 'procore-orange-text');
            btn.classList.add('text-gray-400');
        });

        // Show the selected content and activate the clicked button
        const selectedContent = document.getElementById(contentId);
        if (selectedContent) {
            selectedContent.style.display = 'block';
            button.classList.remove('text-gray-400');
            button.classList.add('active-award-tab', 'procore-orange-text');
        }
    }


    /**
     * Handler for nested desktop navigation clicks. Scrolls to the section, then activates the tab.
     */
    function handleNavTabClick(sectionId, buttonId, contentId, event) {
        if (event && typeof event.preventDefault === 'function') {
            event.preventDefault();
        }

        const targetElement = document.getElementById(sectionId);
        const tabButton = document.getElementById(buttonId);

        if (targetElement && tabButton) {
            
            toggleDropdownCleanup();
            
            targetElement.scrollIntoView({ behavior: 'smooth', block: 'start' });

            toggleTab(contentId, tabButton, false);
        }
    }


    // --- EVENT LISTENERS ---

    document.addEventListener('click', (event) => {
        // Elements that should keep the dropdown open if clicked inside
        const isHeaderButton = event.target.closest('button[id^="dropdown-toggle-"]') || event.target.closest('#header-explore-toggle');
        const isHeaderDropdownContent = event.target.closest('.header-dropdown-menu');
        const isMobileToggle = event.target.closest('#mobile-menu-toggle');

        if (!isHeaderButton && !isHeaderDropdownContent && !isMobileToggle) {
            toggleDropdownCleanup();
        }
    });

    document.addEventListener('DOMContentLoaded', () => {
        // --- Custom Handler for All Internal Anchor Links ---
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            if (anchor.getAttribute('onclick')) {
                return;
            }
            
            const href = anchor.getAttribute('href');
            const targetId = href.substring(1);

            if (href.length > 1 && href.startsWith('#') && document.getElementById(targetId)) {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault();
                    scrollToSection(targetId);
                });
            }
        });
        
        // --- Initial Tab Load: Set the default tabs to open on load ---
        
        const defaultWorkstreamsTabButton = document.getElementById('workstreams-tab-button');
        if (defaultWorkstreamsTabButton) {
            toggleTab('workstreams-tab-content', defaultWorkstreamsTabButton, false);
        }
        
        // Handle Enterprise tab default (now Learning & Development)
        const defaultEnterpriseTabButton = document.getElementById('learning-tab-button');
        if (defaultEnterpriseTabButton) {
            toggleTab('learning-tab-content', defaultEnterpriseTabButton, false);
        }
        
        const defaultSpotlightTabButton = document.getElementById('spotlight-projects-tab-button');
        if (defaultSpotlightTabButton) {
            toggleTab('spotlight-projects-tab-content', defaultSpotlightTabButton, false);
        }
        
        // Default inner tab load for Legal Tech Tools & Trials (Should be the first item, which is now Established Tools)
        const defaultInnerTabButton = document.getElementById('established-sub-tab-button');
        if (defaultInnerTabButton) {
            // Need to manually toggle it to display the first tab content correctly if the initial element is invisible.
             const contentId = defaultInnerTabButton.getAttribute('onclick').match(/'([^']+)'/)[1];
             if (contentId) {
                 const content = document.getElementById(contentId);
                 if (content) content.style.display = 'block';
             }
             defaultInnerTabButton.classList.add('active');
        } else {
             // Fallback to ensuring the visible tab is marked active
             const fallbackInnerTabButton = document.getElementById('lic-sub-tab-button');
             if (fallbackInnerTabButton) {
                 fallbackInnerTabButton.classList.add('active');
             }
        }
        
        // Set default for the new Awards inner tab
        const defaultAwardInnerTabButton = document.getElementById('award-overview-button');
        if (defaultAwardInnerTabButton) {
             const contentId = 'award-overview-content';
             const content = document.getElementById(contentId);
             if (content) content.style.display = 'block';
             defaultAwardInnerTabButton.classList.add('active-award-tab', 'procore-orange-text');
        }
        
    });


    // Initialize Three.js on load and set up resize listener
    window.onload = function() {
        window.addEventListener('resize', onWindowResize);
        initCarousel();
        animate();
    };

</script>

</body>
</html>
