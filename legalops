<script>
    // --- THREE.JS LOGIC FOR DYNAMIC BANNER BACKGROUND ---
    let renderer, camera, scene, cubes = [];
    let backgroundPlane; 
    const textureLoader = new THREE.TextureLoader();
    
    // Custom assets matching Procore theme
    const backgroundImage = 'https://placehold.co/1200x600/FF5200/FF5200?text=Procore+Orange'; 
    const patentDiagramUrl = 'https://placehold.co/2000x240/1A1A1A/1A1A1A?text=ABSTRACT+CONSTRUCTION+PLAN'; // Darker watermark for subtlety

    function getBannerHeight() {
        // Retrieve explicit height from the HTML element's inline style
        const wrapper = document.getElementById('banner-canvas-wrapper');
        if (wrapper && wrapper.style.height) {
            return parseFloat(wrapper.style.height);
        }
        return 450; // Updated default fallback height
    }

    function updateCanvasSize() {
        const canvas = document.getElementById('carousel-canvas');
        if (!canvas) return;
        
        const newWidth = canvas.parentElement ? canvas.parentElement.clientWidth : window.innerWidth;
        const newHeight = getBannerHeight(); 
        
        if (renderer && camera) {
            renderer.setSize(newWidth, newHeight);
            camera.aspect = newWidth / newHeight;
            camera.updateProjectionMatrix();
        }
    }
    
    function initCarousel() {
        const canvas = document.getElementById('carousel-canvas');
        if (!canvas) return;

        const initialHeight = getBannerHeight(); 

        scene = new THREE.Scene();
        // Set Procore Orange as the initial fallback background color
        scene.background = new THREE.Color(0xFF5200); 

        // Initialize camera
        camera = new THREE.PerspectiveCamera(75, canvas.clientWidth / initialHeight, 0.1, 1000);
        camera.position.z = 5.5; 

        renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true, alpha: true });
        
        updateCanvasSize(); 

        // Lights
        const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
        scene.add(ambientLight);
        const directionalLight = new THREE.DirectionalLight(0xffffff, 0.8);
        directionalLight.position.set(0, 5, 5);
        scene.add(directionalLight);
        
        
        // 1. Set Primary Background to Texture (Procore Orange)
        textureLoader.load(backgroundImage, 
            function(texture) {
                texture.colorSpace = THREE.SRGBColorSpace;
                scene.background = texture;
            },
            undefined,
            function(err) {
                console.error('Error loading background image:', err);
                // Ensure orange fallback on texture load failure
                scene.background = new THREE.Color(0xFF5200); 
            }
        );
        
        // 2. Watermark Layer (Abstract pattern in light gray for contrast)
        textureLoader.load(patentDiagramUrl, 
            function(texture) {
                texture.colorSpace = THREE.SRGBColorSpace;
                
                const backgroundGeometry = new THREE.PlaneGeometry(20, 10); 
                const backgroundMaterial = new THREE.MeshBasicMaterial({
                    map: texture,
                    transparent: true,
                    opacity: 0.3, 
                    side: THREE.DoubleSide
                });

                backgroundPlane = new THREE.Mesh(backgroundGeometry, backgroundMaterial);
                backgroundPlane.position.z = -1; 
                backgroundPlane.rotation.z = -Math.PI * 0.05; 
                backgroundPlane.position.y = -1;
                scene.add(backgroundPlane);
            },
            undefined,
            function(err) {
                console.error('Error loading patent diagram texture:', err);
            }
        );

        // Cube Definitions (Abstract concepts)
        const excitingAreas = [
            { title: "Legal Tech", color: 0xff5200, position: -1.8 }, 
            { title: "Process", color: 0x000000, position: 0.0 }, 
            { title: "Strategy", color: 0xff5200, position: 1.8 }
        ];

        const width = 2.0, height = 3.0, depth = 0.8, segments = 10; 

        excitingAreas.forEach((area) => {
            const cubeGeometry = new THREE.BoxGeometry(width, height, depth, segments, segments, segments);
            cubeGeometry.computeVertexNormals(); 
            
            // Darker colors for the 3D objects
            const materialColor = area.color === 0x000000 ? 0x222222 : 0xcc4400; 
            const material = new THREE.MeshPhongMaterial({ 
                color: materialColor, 
                emissive: materialColor, 
                emissiveIntensity: 0.2, 
                shininess: 80, 
                specular: 0xcccccc 
            });
            
            const cube = new THREE.Mesh(cubeGeometry, material);
            
            cube.position.x = area.position;
            cube.userData.rotationSpeed = 0.01;
            cubes.push(cube);
            scene.add(cube);
        });
    }

    let animationFrameId;

    function animate() {
        animationFrameId = requestAnimationFrame(animate);

        if (backgroundPlane) {
            backgroundPlane.rotation.z += 0.0005; 
            backgroundPlane.position.x = Math.sin(Date.now() * 0.0001) * 0.5;
        }
        
        cubes.forEach(cube => {
            cube.rotation.y += cube.userData.rotationSpeed * 0.5;
            cube.rotation.x += cube.userData.rotationSpeed / 4; 
            cube.rotation.z += cube.userData.rotationSpeed / 8;
            
            cube.updateMatrixWorld(true);
            
            // Subtle pulsing scale animation
            const scaleFactor = 1 + Math.sin(Date.now() * 0.001 * cube.userData.rotationSpeed * 20) * 0.03;
            cube.scale.x = cube.scale.y = cube.scale.z = scaleFactor;
        });

        if (renderer) {
            renderer.render(scene, camera);
        }
    }

    function onWindowResize() {
        updateCanvasSize();
    }
    // --- END THREE.JS LOGIC ---

    // --- MAIN SCRIPT LOGIC (Dropdown, Mobile Menu, Collapsible, Explore) ---

    /**
     * Toggles the visibility of a specified dropdown menu (used for header nav).
     */
    function toggleDropdown(menuId, button) {
        const menu = document.getElementById(menuId);
        const icon = button.querySelector('.dropdown-icon');

        // Close other desktop dropdowns
        document.querySelectorAll('.rounded-lg[role="menu"], .header-dropdown-menu').forEach(otherMenu => {
            if (otherMenu.id !== menuId) {
                otherMenu.classList.add('hidden');
            }
        });
        document.querySelectorAll('.nav-item-button .dropdown-icon').forEach(otherIcon => {
            // Find the correct parent button for the icon
            if (otherIcon !== icon && otherIcon.closest('button').id.startsWith('dropdown-toggle')) {
                otherIcon.style.transform = 'rotate(0deg)';
            }
        });
        
        // Also close the middle Explore menu (specific fix)
        document.getElementById('explore-menu-1').classList.add('hidden');
        document.getElementById('explore-menu-2a').classList.add('hidden');
        document.getElementById('explore-menu-2b').classList.add('hidden');
        const exploreIcon = document.getElementById('explore-toggle-1')?.querySelector('.dropdown-icon');
        if (exploreIcon) exploreIcon.style.transform = 'rotate(0deg)';
        
        // Also close the header Explore menu
        document.getElementById('header-explore-menu-1').classList.add('hidden');
        document.getElementById('header-explore-menu-2a').classList.add('hidden');
        document.getElementById('header-explore-menu-2b').classList.add('hidden');
        const headerExploreIcon = document.getElementById('header-explore-toggle')?.querySelector('.dropdown-icon');
        if (headerExploreIcon) headerExploreIcon.style.transform = 'rotate(0deg)';

        menu.classList.toggle('hidden');

        if (!menu.classList.contains('hidden')) {
            icon.style.transform = 'rotate(180deg)';
        } else {
            icon.style.transform = 'rotate(0deg)';
        }
    }

    /**
     * Toggles the mobile menu for small screens.
     */
    function toggleMobileMenu() {
        const mobileMenu = document.getElementById('mobile-menu');
        const openIcon = document.getElementById('menu-open-icon');
        const closeIcon = document.getElementById('menu-close-icon');

        const isOpen = mobileMenu.classList.toggle('open');
        
        openIcon.classList.toggle('hidden', isOpen);
        closeIcon.classList.toggle('hidden', !isOpen);

        mobileMenu.setAttribute('aria-expanded', isOpen);

        if (!isOpen) {
            document.querySelectorAll('.bg-gray-800[id^="mobile-dropdown-menu-"]').forEach(subDropdown => {
                subDropdown.classList.add('hidden');
            });
        }
    }

    /**
     * Toggles the visibility of a collapsible section.
     */
    function toggleCollapsible(contentId, button) {
        const content = document.getElementById(contentId);
        if (content) {
            const isOpening = !content.classList.contains('open');
            
            content.classList.toggle('open');
            button.classList.toggle('open');
            button.setAttribute('aria-expanded', isOpening);
            
            // NOTE: Removed `scrollTarget.scrollIntoView` call here to fix unwanted scrolling
        }
    }

    /**
     * Toggles the visibility of the main Explore menu (Level 1).
     */
    function toggleExploreDropdown(menuId, button) {
        const menu = document.getElementById(menuId);
        
        // 1. Close all other main header dropdowns explicitly via toggleDropdown
        document.querySelectorAll('nav .relative button[id^="dropdown-toggle-"]').forEach(btn => {
            const match = btn.getAttribute('onclick').match(/'(.*?)'/);
            const btnMenuId = match ? match[1] : null;
            if (btnMenuId && btnMenuId !== menuId) {
                document.getElementById(btnMenuId).classList.add('hidden');
                btn.querySelector('.dropdown-icon').style.transform = 'rotate(0deg)';
            }
        });

        // 2. Close the *other* Explore menu if it's open (header vs utility)
        const isHeader = menuId.startsWith('header-');
        const otherExploreMenuId = isHeader ? 'explore-menu-1' : 'header-explore-menu-1';
        const otherExploreMenu = document.getElementById(otherExploreMenuId);
        if (otherExploreMenu) {
            otherExploreMenu.classList.add('hidden');
            // Reset the other Explore icon
            const otherExploreToggleId = isHeader ? 'explore-toggle-1' : 'header-explore-toggle';
            const otherExploreIcon = document.getElementById(otherExploreToggleId)?.querySelector('.dropdown-icon');
            if (otherExploreIcon) otherExploreIcon.style.transform = 'rotate(0deg)';
        }


        // 3. Close all Level 2 menus associated with the target menu area
        document.getElementById('explore-menu-2a').classList.add('hidden');
        document.getElementById('explore-menu-2b').classList.add('hidden');
        document.getElementById('header-explore-menu-2a').classList.add('hidden');
        document.getElementById('header-explore-menu-2b').classList.add('hidden');
        // Reset all Level 2 icons
        document.getElementById('icon-2a').style.transform = 'rotate(0deg)';
        document.getElementById('icon-2b').style.transform = 'rotate(0deg)';
        const headerIcon2a = document.getElementById('header-icon-2a');
        if (headerIcon2a) headerIcon2a.style.transform = 'rotate(0deg)';
        const headerIcon2b = document.getElementById('header-icon-2b');
        if (headerIcon2b) headerIcon2b.style.transform = 'rotate(0deg)';


        // 4. Toggle the target Level 1 menu
        const isHidden = menu.classList.toggle('hidden');

        // 5. Toggle the main arrow icon
        const mainIcon = button.querySelector('.dropdown-icon');
        if (mainIcon) {
            if (!isHidden) {
                mainIcon.style.transform = 'rotate(180deg)';
            } else {
                mainIcon.style.transform = 'rotate(0deg)';
            }
        }
    }

    /**
     * Toggles the visibility of a nested Explore sub-dropdown (Level 2).
     */
    function toggleExploreSubDropdown(subMenuId, button) {
        const subMenu = document.getElementById(subMenuId);
        const icon = button.querySelector('svg'); // Get the specific icon inside the button
        const isHeaderMenu = subMenuId.startsWith('header-');

        // Determine sibling IDs based on whether it's the header or utility menu
        let siblingMenuIds, siblingIconIds;
        if (isHeaderMenu) {
            siblingMenuIds = (subMenuId === 'header-explore-menu-2a') ? ['header-explore-menu-2b'] : ['header-explore-menu-2a'];
            siblingIconIds = (subMenuId === 'header-explore-menu-2a') ? ['header-icon-2b'] : ['header-icon-2a'];
        } else {
            siblingMenuIds = (subMenuId === 'explore-menu-2a') ? ['explore-menu-2b'] : ['explore-menu-2a'];
            siblingIconIds = (subMenuId === 'explore-menu-2a') ? ['icon-2b'] : ['icon-2a'];
        }
        
        // Close the sibling Level 2 menu
        siblingMenuIds.forEach(siblingId => {
            const siblingMenu = document.getElementById(siblingId);
            if (siblingMenu && !siblingMenu.classList.contains('hidden')) {
                siblingMenu.classList.add('hidden');
            }
        });
        siblingIconIds.forEach(siblingIconId => {
            const siblingIcon = document.getElementById(siblingIconId);
             if(siblingIcon) siblingIcon.style.transform = 'rotate(0deg)';
        });


        // Toggle the target Level 2 menu
        const isHidden = subMenu.classList.toggle('hidden');
        
        // Toggle the right-arrow icon for the current sub-menu
        if (!isHidden) {
            icon.style.transform = 'rotate(90deg)';
        } else {
            icon.style.transform = 'rotate(0deg)';
        }
    }

    /**
     * Filters content blocks based on the search input value.
     * Searches content by title/tooltip text.
     */
    function filterContent(query) {
        const searchText = query.toLowerCase().trim();
        // Target elements that are visually distinct and link to content
        // Including the collapsible buttons themselves for searchable text
        const items = document.querySelectorAll('.searchable-item, .workstream-card, #spotlight-container, #updates-toggle-button, #tools-toggle-button, #trends-toggle-button, #tools-trials-toggle-button, #legal-tools-toggle, #recent-trials-toggle, #team-highlights-toggle-button');
        
        // Check if we are actively searching
        const isSearching = searchText.length > 0;

        items.forEach(item => {
            let searchableText = (item.title || item.textContent).toLowerCase();
            
            // Include nested content for complex sections
            if (item.classList.contains('ai-card') || item.id === 'spotlight-container' || item.classList.contains('workstream-card') || item.classList.contains('collapsible-button')) {
                searchableText += ' ' + item.textContent.toLowerCase();
            }

            const isMatch = searchableText.includes(searchText);

            // Determine the element to hide/show based on its purpose
            let elementToControl = item;
            
            // Handle different display styles for direct child elements in a grid/flex
            let displayStyle = 'block';

            if (item.closest('#small-stories-container')) {
                displayStyle = 'flex'; // Small story cards are flex children
            } else if (item.classList.contains('ai-card')) {
                displayStyle = 'block'; // AI cards are block children of a grid
            } else if (item.classList.contains('workstream-card')) {
                displayStyle = 'block'; // Workstream cards are block children of a grid
            } else if (item.classList.contains('collapsible-button')) {
                 // Collapsible buttons should remain block-level elements
                displayStyle = 'flex'; 
            } else if (item.id === 'spotlight-container') {
                displayStyle = 'block'; 
            }


            // Apply display logic
            if (isSearching) {
                elementToControl.style.display = isMatch ? displayStyle : 'none';
            } else {
                // If search is empty, clear inline display style to restore original CSS/Tailwind classes
                elementToControl.style.display = '';
            }
        });

        // Toggle Collapsible Sections based on search status
        document.querySelectorAll('.collapsible-button[id$="-toggle-button"], .collapsible-button[id^="legal-tools-toggle"], .collapsible-button[id^="recent-trials-toggle"], #team-highlights-toggle-button').forEach(button => {
            const match = button.getAttribute('onclick').match(/'(.*?)'/);
            const contentId = match ? match[1] : null;
            const content = document.getElementById(contentId);
            const isButtonMatch = button.style.display !== 'none';

            if (content) {
                if (isSearching) {
                    // When searching, collapse sections unless the button itself matched the search query
                    if (isButtonMatch) {
                          // If the button title matched, keep the button displayed, but the content should still be collapsed unless the content itself is part of the "searchable items" logic above.
                        content.classList.remove('open');
                        button.classList.remove('open');
                        button.setAttribute('aria-expanded', 'false');

                    } else {
                        // If the button didn't match, it's already display:none, and the content remains closed.
                        content.classList.remove('open');
                    }
                } else {
                    // When search is cleared, restore them to their default 'open' state (all default to open in your HTML)
                    content.classList.add('open');
                    button.classList.add('open');
                    button.setAttribute('aria-expanded', 'true');
                    
                    // Reset visibility explicitly in case the logic above hid it
                    button.style.display = 'flex';
                }
            }
        });
    }


    // --- EVENT LISTENERS ---

    /**
     * Closes desktop dropdowns if the user clicks anywhere else on the document.
     */
    document.addEventListener('click', (event) => {
        // Elements that should keep the dropdown open if clicked
        const isHeaderButton = event.target.closest('button[id^="dropdown-toggle-"]');
        const isHeaderDropdownContent = event.target.closest('#dropdown-menu-1, #dropdown-menu-2, #dropdown-menu-3');
        const isExploreButton = event.target.closest('#header-explore-toggle, #explore-toggle-1');
        const isExploreMenu = event.target.closest('#header-explore-menu-1, #explore-menu-1');

        if (!isHeaderButton && !isHeaderDropdownContent && !isExploreButton && !isExploreMenu) {
            
            // Close all standard header dropdowns
            document.querySelectorAll('#dropdown-menu-1, #dropdown-menu-2, #dropdown-menu-3').forEach(menu => {
                menu.classList.add('hidden');
            });
            
            // Reset standard header dropdown icons
            document.querySelectorAll('nav .nav-item-button .dropdown-icon').forEach(icon => {
                if (icon.closest('button') && icon.closest('button').id.startsWith('dropdown-toggle')) {
                    icon.style.transform = 'rotate(0deg)';
                }
            });

            // Close all Explore Menus (Header and Utility)
            document.querySelectorAll('#header-explore-menu-1, #explore-menu-1, #explore-menu-2a, #explore-menu-2b, #header-explore-menu-2a, #header-explore-menu-2b').forEach(menu => {
                menu.classList.add('hidden');
            });
            
            // Reset all Explore Icons
            const iconsToReset = ['header-explore-toggle', 'explore-toggle-1', 'header-icon-2a', 'header-icon-2b', 'icon-2a', 'icon-2b'];
            iconsToReset.forEach(id => {
                const iconElement = document.getElementById(id)?.querySelector('.dropdown-icon') || document.getElementById(id);
                if (iconElement) iconElement.style.transform = 'rotate(0deg)';
            });
        }
    });

    document.addEventListener('DOMContentLoaded', () => {
        // --- Search Listener Setup ---
        const searchInput = document.getElementById('global-search-input');
        if (searchInput) {
            searchInput.addEventListener('input', (e) => {
                filterContent(e.target.value);
            });
        }
        
        // --- ADDED FIX for Smooth Anchor Scrolling ---
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            // Check if the href targets an element that exists
            const href = anchor.getAttribute('href');
            const targetId = href.substring(1);

            if (targetId && document.getElementById(targetId)) {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault();
                    document.getElementById(targetId).scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                });
            }
        });
    });


    // Initialize Three.js on load and set up resize listener
    window.onload = function() {
        window.addEventListener('resize', onWindowResize);
        initCarousel();
        animate();
    };

</script>

