            <!-- Desktop Menu (visible on large screens) -->
            <!-- RESTORED space-x-2 for comfortable spacing -->
            <nav class="hidden md:flex space-x-2 items-center">
                
                <!-- NEW EXPLORE DROPDOWN (Mirrors utility bar logic) - STYLED TO MATCH OTHERS -->
                <div class="relative">
