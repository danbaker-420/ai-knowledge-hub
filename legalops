<script>
    // --- THREE.JS LOGIC FOR DYNAMIC BANNER BACKGROUND ---
    let renderer, camera, scene, cubes = [];
    let backgroundPlane; 
    const textureLoader = new THREE.TextureLoader();
    
    // Custom assets matching Procore theme
    const backgroundImage = 'https://placehold.co/1200x600/FF5200/FF5200?text=Procore'; 
    const patentDiagramUrl = 'https://placehold.co/2000x240/D0D0D0/D0D0D0?text=ABSTRACT+CONSTRUCTION+PLAN'; 

    function getBannerHeight() {
        // Retrieve explicit height from the HTML element's inline style
        const wrapper = document.getElementById('banner-canvas-wrapper');
        if (wrapper && wrapper.style.height) {
            return parseFloat(wrapper.style.height);
        }
        return 500; // Updated default fallback height
    }

    function updateCanvasSize() {
        const canvas = document.getElementById('carousel-canvas');
        if (!canvas) return;
        
        const newWidth = canvas.parentElement ? canvas.parentElement.clientWidth : window.innerWidth;
        const newHeight = getBannerHeight(); 
        
        if (renderer && camera) {
            renderer.setSize(newWidth, newHeight);
            camera.aspect = newWidth / newHeight;
            camera.updateProjectionMatrix();
        }
    }
    
    function initCarousel() {
        const canvas = document.getElementById('carousel-canvas');
        if (!canvas) return;

        const initialHeight = getBannerHeight(); 

        scene = new THREE.Scene();
        scene.background = new THREE.Color(0xff5200); // Procore Orange fallback 

        // Initialize camera
        camera = new THREE.PerspectiveCamera(75, canvas.clientWidth / initialHeight, 0.1, 1000);
        camera.position.z = 5.5; 

        renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true, alpha: true });
        
        updateCanvasSize(); 

        // Lights
        const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
        scene.add(ambientLight);
        const directionalLight = new THREE.DirectionalLight(0xffffff, 0.8);
        directionalLight.position.set(0, 5, 5);
        scene.add(directionalLight);
        
        
        // 1. Set Primary Background to Texture (Procore Orange)
        textureLoader.load(backgroundImage, 
            function(texture) {
                texture.colorSpace = THREE.SRGBColorSpace;
                scene.background = texture;
            },
            undefined,
            function(err) {
                console.error('Error loading background image:', err);
                scene.background = new THREE.Color(0xff5200); 
            }
        );
        
        // 2. Watermark Layer (Abstract pattern in light gray for contrast)
        textureLoader.load(patentDiagramUrl, 
            function(texture) {
                texture.colorSpace = THREE.SRGBColorSpace;
                
                const backgroundGeometry = new THREE.PlaneGeometry(20, 10); 
                const backgroundMaterial = new THREE.MeshBasicMaterial({
                    map: texture,
                    transparent: true,
                    opacity: 0.3, 
                    side: THREE.DoubleSide
                });

                backgroundPlane = new THREE.Mesh(backgroundGeometry, backgroundMaterial);
                backgroundPlane.position.z = -1; 
                backgroundPlane.rotation.z = -Math.PI * 0.05; 
                backgroundPlane.position.y = -1;
                scene.add(backgroundPlane);
            },
            undefined,
            function(err) {
                console.error('Error loading patent diagram texture:', err);
            }
        );

        // Cube Definitions (Abstract concepts)
        const excitingAreas = [
            { title: "Legal Tech", color: 0xff5200, position: -1.8 }, 
            { title: "Process", color: 0x000000, position: 0.0 }, 
            { title: "Strategy", color: 0xff5200, position: 1.8 }
        ];

        const width = 2.0, height = 3.0, depth = 0.8, segments = 10; 

        excitingAreas.forEach((area) => {
            const cubeGeometry = new THREE.BoxGeometry(width, height, depth, segments, segments, segments);
            cubeGeometry.computeVertexNormals(); 
            
            // Darker colors for the 3D objects
            const materialColor = area.color === 0x000000 ? 0x222222 : 0xcc4400; 
            const material = new THREE.MeshPhongMaterial({ 
                color: materialColor, 
                emissive: materialColor, 
                emissiveIntensity: 0.2, 
                shininess: 80, 
                specular: 0xcccccc 
            });
            
            const cube = new THREE.Mesh(cubeGeometry, material);
            
            cube.position.x = area.position;
            cube.userData.rotationSpeed = 0.01;
            cubes.push(cube);
            scene.add(cube);
        });
    }

    let animationFrameId;

    function animate() {
        animationFrameId = requestAnimationFrame(animate);

        if (backgroundPlane) {
            backgroundPlane.rotation.z += 0.0005; 
            backgroundPlane.position.x = Math.sin(Date.now() * 0.0001) * 0.5;
        }
        
        cubes.forEach(cube => {
            cube.rotation.y += cube.userData.rotationSpeed * 0.5;
            cube.rotation.x += cube.userData.rotationSpeed / 4; 
            cube.rotation.z += cube.userData.rotationSpeed / 8;
            
            cube.updateMatrixWorld(true);
            
            // Subtle pulsing scale animation
            const scaleFactor = 1 + Math.sin(Date.now() * 0.001 * cube.userData.rotationSpeed * 20) * 0.03;
            cube.scale.x = cube.scale.y = cube.scale.z = scaleFactor;
        });

        if (renderer) {
            renderer.render(scene, camera);
        }
    }

    function onWindowResize() {
        updateCanvasSize();
    }
    // --- END THREE.JS LOGIC ---

    // --- MAIN SCRIPT LOGIC (Dropdown, Mobile Menu, Collapsible) ---

    /**
     * Toggles the visibility of a specified dropdown menu.
     */
    function toggleDropdown(menuId, button) {
        const menu = document.getElementById(menuId);
        const icon = button.querySelector('.dropdown-icon');

        document.querySelectorAll('.rounded-lg[role="menu"], .bg-gray-800[id^="mobile-dropdown-menu-"]').forEach(otherMenu => {
            if (otherMenu.id !== menuId) {
                otherMenu.classList.add('hidden');
            }
        });
        document.querySelectorAll('.dropdown-icon').forEach(otherIcon => {
            if (otherIcon !== icon) {
                otherIcon.style.transform = 'rotate(0deg)';
            }
        });

        menu.classList.toggle('hidden');

        if (!menu.classList.contains('hidden')) {
            icon.style.transform = 'rotate(180deg)';
        } else {
            icon.style.transform = 'rotate(0deg)';
        }
    }

    /**
     * Toggles the mobile menu for small screens.
     */
    function toggleMobileMenu() {
        const mobileMenu = document.getElementById('mobile-menu');
        const openIcon = document.getElementById('menu-open-icon');
        const closeIcon = document.getElementById('menu-close-icon');

        const isOpen = mobileMenu.classList.toggle('open');
        
        openIcon.classList.toggle('hidden', isOpen);
        closeIcon.classList.toggle('hidden', !isOpen);

        mobileMenu.setAttribute('aria-expanded', isOpen);

        if (!isOpen) {
            document.querySelectorAll('.bg-gray-800[id^="mobile-dropdown-menu-"]').forEach(subDropdown => {
                subDropdown.classList.add('hidden');
            });
        }
    }

    /**
     * Toggles the visibility of a collapsible section.
     * Also updates the ARIA attribute.
     */
    function toggleCollapsible(contentId, button) {
        const content = document.getElementById(contentId);
        if (content) {
            const isOpening = !content.classList.contains('open');
            
            content.classList.toggle('open');
            button.classList.toggle('open');
            button.setAttribute('aria-expanded', isOpening);
            
            // Check if we need to scroll to the button if the content is opening
            if (isOpening) {
                button.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }
    }

    /**
     * Closes desktop dropdowns if the user clicks anywhere else on the document.
     */
    document.addEventListener('click', (event) => {
        const isButton = event.target.closest('button[id^="dropdown-toggle-"]');
        const isDropdownContent = event.target.closest('.rounded-lg[role="menu"]');

        if (!isButton && !isDropdownContent) {
            document.querySelectorAll('.rounded-lg[role="menu"]').forEach(menu => {
                menu.classList.add('hidden');
            });
            document.querySelectorAll('.dropdown-icon').forEach(icon => {
                icon.style.transform = 'rotate(0deg)';
            });
        }
    });

    // --- NEW: Search Logic Implementation ---
    function filterContent(searchTerm) {
        const query = searchTerm.toLowerCase().trim();
        
        // 1. Target all main searchable containers
        const workstreamCards = document.querySelectorAll('.workstream-card');
        const resourceItems = document.querySelectorAll('#integration-resources-section .searchable-item');
        const storyItems = document.querySelectorAll('#stories-section .searchable-item');
        
        // 2. Target Spotlight elements
        const spotlightContainer = document.getElementById('spotlight-container');
        const spotlightInterviewContent = document.getElementById('spotlight-interview-content');
        const spotlightButton = document.getElementById('spotlight-toggle-button');
        
        let foundMatchInSpotlight = false;
        let isSearchActive = query !== '';

        // --- Reset / General Filtering ---
        [...workstreamCards, ...resourceItems, ...storyItems].forEach(item => {
            const content = item.textContent || '';
            const isMatch = content.toLowerCase().includes(query);
            
            // Show item if match found or if search is cleared
            item.style.display = (isMatch || !isSearchActive) ? (item.classList.contains('workstream-card') ? 'block' : 'flex') : 'none';

            // Ensure grid items (stories) use correct flex/block display on reset
            if (item.closest('#stories-section')) {
                 item.style.display = (isMatch || !isSearchActive) ? 'flex' : 'none';
            }
        });

        // --- Spotlight Specific Filtering ---
        if (spotlightContainer) {
            const spotlightContentText = spotlightContainer.textContent || '';
            const spotlightMatch = spotlightContentText.toLowerCase().includes(query);

            if (spotlightMatch) {
                spotlightContainer.style.display = 'block';
                foundMatchInSpotlight = true;

                // If a match is found in the hidden content, force it open
                if (isSearchActive && spotlightInterviewContent && spotlightButton) {
                    spotlightInterviewContent.classList.add('open');
                    spotlightButton.classList.add('open');
                    spotlightButton.setAttribute('aria-expanded', true);
                }
            } else if (isSearchActive) {
                spotlightContainer.style.display = 'none';
            } else {
                // Reset to default visibility
                spotlightContainer.style.display = 'block';
            }
        }
        
        // --- Reset Collapsible State when search is cleared ---
        if (!isSearchActive && spotlightInterviewContent && spotlightButton) {
            spotlightInterviewContent.classList.remove('open');
            spotlightButton.classList.remove('open');
            spotlightButton.setAttribute('aria-expanded', false);
        }


        // --- Hide/Show main sections based on content visibility ---
        const sections = document.querySelectorAll('main > div > section');
        sections.forEach(section => {
            if (!isSearchActive) {
                section.style.display = 'block';
                return;
            }

            // Check if any children are visible
            const visibleChildren = Array.from(section.querySelectorAll('.workstream-card, .searchable-item, #spotlight-container')).filter(child => {
                // Special check for spotlight since it's a nested container
                if (child.id === 'spotlight-container') {
                    return foundMatchInSpotlight;
                }
                return child.style.display !== 'none';
            });

            section.style.display = visibleChildren.length > 0 ? 'block' : 'none';
        });
    }

    document.addEventListener('DOMContentLoaded', () => {
        // --- Search Listener Setup ---
        const searchInput = document.getElementById('global-search-input');
        if (searchInput) {
            searchInput.addEventListener('input', (e) => {
                filterContent(e.target.value);
            });
        }
    });


    // Initialize Three.js on load and set up resize listener
    window.onload = function() {
        window.addEventListener('resize', onWindowResize);
        initCarousel();
        animate();
    };

</script>

