        .dropdown-header {
            padding: 1rem 1.5rem;
            border-bottom: 1px solid #1f2937;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .dropdown-header-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: #ffffff;
        }
        .dropdown-link {
            display: block;
            padding: 0.75rem 1.5rem;
            font-size: 1rem;
            color: #ffffff;
