        /* Primary Dropdown Icon Rotation */
        .nav-item-button:hover .dropdown-icon {
            transform: rotate(180deg);
        }
        .nav-item-button {
            transition: background-color 0.2s, transform 0.2s;
            /* Ensure buttons start content left for left alignment */
            justify-content: flex-start; 
        }
        .dropdown-icon {
            transition: transform 0.3s ease;
        }
        /* Nested Dropdown Icon Rotation (Right arrow changes to down arrow 90deg) */
        .nested-dropdown-button .dropdown-icon-nested {
            transition: transform 0.3s ease;
            transform: rotate(0deg); /* Default right arrow position */
        }
        .nested-dropdown-button.open .dropdown-icon-nested {
            /* This is handled by JS now, but setting the transition here is good */
            transition: transform 0.3s ease;
        }

        #mobile-menu {
            transition: max-height 0.3s ease-out, opacity 0.3s ease-out;
            max-height: 0;
            overflow: hidden;
            opacity: 0;
        }
        #mobile-menu.open {
            max-height: 500px;
            opacity: 1;
        }
        .header-dropdown-menu {
            width: 300px;
            background-color: #111827;
            border-radius: 0.75rem;
