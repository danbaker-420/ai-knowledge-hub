                        </svg>
                    </button>

                    <!-- Main Dropdown Menu (Level 1) - REDESIGNED -->
                    <div id="header-explore-menu-1" class="origin-top-left absolute left-0 mt-2 header-dropdown-menu hidden z-30" role="menu">
                        <div class="dropdown-header">
                            <h3 class="dropdown-header-title">Explore</h3>
                            <svg class="w-6 h-6 procore-orange-text" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10l-3.293-3.293a1 1 0 111.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
                            </svg>
                        </div>
                        <div class="py-1" role="none">
                            
                            <!-- UPDATED LINK: AI News & Team Highlights -->
                            <a href="#lrc-team-updates-section" class="dropdown-link rounded-t-xl" title="Highlights and announcements for new corporate AI features, tools, and platforms.">
                                AI News & Team Highlights
                            </a>
                            <!-- NEW LINK: LRC Learning & Innovation Showcase -->
                            <a href="#stories-section" class="dropdown-link" title="Featured projects, training updates, and innovation stories from the LRC team.">
                                LRC Learning & Innovation Showcase
                            </a>

                            <!-- Sub-Dropdown 1: Enterprise AI Resources (Level 2 Toggle) -->
                            <div class="relative">
                                <button id="header-explore-toggle-2a" class="w-full text-left flex justify-between items-center nested-dropdown-button text-sm font-medium text-white hover:bg-gray-800" onclick="toggleExploreSubDropdown('header-explore-menu-2a', this)">
                                    Enterprise AI Resources
                                    <svg class="ml-2 h-4 w-4 transform transition-transform duration-200" id="header-icon-2a" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                        <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10l-3.293-3.293a1 1 0 111.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
                                    </svg>
                                </button>
                                
                                <!-- Sub-Dropdown Content 1 (Level 2) -->
                                <div id="header-explore-menu-2a" class="hidden absolute top-0 left-full ml-1 w-64 rounded-xl shadow-2xl bg-gray-800 border border-gray-700 z-40 nested-dropdown-content" role="menu">
                                    <a href="#tools-toggle-button" class="text-sm text-white hover:bg-gray-700 rounded-b-xl">Procore Enterprise Tools</a>
                                </div>
                            </div>

                            <!-- Sub-Dropdown 2: Legal Specific-Resources (Level 2 Toggle) -->
                            <div class="relative">
                                <button id="header-explore-toggle-2b" class="w-full text-left flex justify-between items-center nested-dropdown-button text-sm font-medium text-white hover:bg-gray-800 rounded-b-xl" onclick="toggleExploreSubDropdown('header-explore-menu-2b', this)">
                                    Legal-Specific Resources
                                    <svg class="ml-2 h-4 w-4 transform transition-transform duration-200" id="header-icon-2b" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                        <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10l-3.293-3.293a1 1 0 111.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
                                    </svg>
                                </button>
                                
                                <!-- Sub-Dropdown Content 2 (Level 2) -->
                                <div id="header-explore-menu-2b" class="hidden absolute top-0 left-full ml-1 w-64 rounded-xl shadow-2xl bg-gray-800 border border-gray-700 z-40 nested-dropdown-content" role="menu">
                                    <a href="#trends-toggle-button" class="text-sm text-white hover:bg-gray-700 rounded-t-xl">Legal Industry Topics & Trends</a>
                                    <a href="#tools-trials-toggle-button" class="text-sm text-white hover:bg-gray-700 rounded-b-xl">Legal AI Tech Tools & Recent Trials</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- END NEW EXPLORE DROPDOWN -->


                <!-- LRC Team Spotlight (Now points to the nested section) -->
                <a href="#lrc-team-spotlight-section" class="nav-item-button text-gray-400 hover:text-white px-3 py-2 rounded-lg text-base font-medium transition-colors">
                    LRC Team Spotlight
                </a>

                <!-- Dropdown Menu 1: Blogs - RESTORED WRAPPER -->
                <div class="relative">
                    <button id="dropdown-toggle-1" class="nav-item-button flex items-center text-gray-400 hover:text-white px-3 py-2 rounded-lg text-base font-medium" onclick="toggleDropdown('dropdown-menu-1', this)">
                        Blogs
                        <!-- Down Arrow Icon -->
                        <svg class="ml-2 h-4 w-4 dropdown-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                        </svg>
                    </button>
                    
                    <!-- Dropdown Content (Blogs) - NEW STRUCTURE AND CLASS -->
                    <div id="dropdown-menu-1" class="origin-top-right absolute right-0 mt-2 header-dropdown-menu hidden" role="menu">
                        <div class="dropdown-header">
                            <h3 class="dropdown-header-title">Blogs</h3>
                            <svg class="w-6 h-6 procore-orange-text" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10l-3.293-3.293a1 1 0 111.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
                            </svg>
                        </div>
                        <div class="py-1" role="none">
                            <a href="https://www.therundown.ai/subscribe" target="_blank" title="Curated daily AI news delivered in a brief, easy-to-read format." class="dropdown-link rounded-t-lg">The Rundown</a>
