<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LRC AI Knowledge Hub</title>
    <!-- Load Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Load Three.js for the dynamic banner background -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    
    <style>
        /* Custom font and Procore theme */
        body {
            font-family: 'Inter', sans-serif;
            background-color: #000000; /* Procore Black - Main Background */
            color: #ECE0D6; /* Procore Stone - Default Text */
            /* The following line enables smooth scrolling for modern browsers */
            scroll-behavior: smooth; 
        }
        /* Navigation styles */
        .nav-item-button:hover .dropdown-icon {
            transform: rotate(180deg);
        }
        .nav-item-button {
            transition: background-color 0.2s, transform 0.2s;
        }
        .dropdown-icon {
            transition: transform 0.3s ease;
        }
        /* Mobile menu specific styles */
        #mobile-menu {
            transition: max-height 0.3s ease-out, opacity 0.3s ease-out;
            max-height: 0;
            overflow: hidden;
            opacity: 0;
        }
        #mobile-menu.open {
            max-height: 500px; /* A large enough value to accommodate content */
            opacity: 1;
        }
        
        /* --- NEW: Header Dropdown Overrides (Matches attached NASA style) --- */
        .header-dropdown-menu {
            width: 300px; /* Wider menu */
            background-color: #111827; /* bg-gray-900 */
            border-radius: 0.75rem;
            box-shadow: 0 10px 15px rgba(0, 0, 0, 0.5);
        }
        .dropdown-header {
            padding: 1rem 1.5rem;
            border-bottom: 1px solid #1f2937; /* border-gray-800 */
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .dropdown-header-title {
            font-size: 1.5rem; /* text-2xl */
            font-weight: 700; /* font-bold */
            color: #ffffff;
        }
        /* NOTE: This class now defines the standard padding for ALL Level 1 dropdown links */
        .dropdown-link {
            display: block;
            padding: 0.75rem 1.5rem; /* Standard L1 padding (px-6 py-3 adjusted to match 0.75rem 1.5rem) */
            font-size: 1rem;
            color: #ffffff; /* text-white */
            transition: background-color 0.2s;
        }
        .dropdown-link:hover {
            background-color: #1f2937; /* bg-gray-800 */
        }
        /* Specific padding adjustment for nested L2 buttons/links */
        .nested-dropdown-button {
            padding: 0.75rem 1.5rem; /* Match L1 link padding for visual consistency */
        }
        .nested-dropdown-content a {
             padding: 0.5rem 2rem; /* Increased left padding for nested visual offset */
             display: block;
        }
        /* END NEW: Header Dropdown Overrides */


        /* --- THREE.JS BANNER STYLES --- */
        #carousel-canvas {
            display: block; 
            width: 100%; 
            height: 100%;
        }
        /* Ensure the overlay is correctly styled for maximum visibility */
        #banner-overlay-text {
            background-color: rgba(0, 0, 0, 0.4); /* Increased opacity to 40% for better contrast */
        }

        /* Procore Orange utility class for hover/active states */
        .procore-orange-text { color: #FF5200; }
        .hover-procore-orange-bg:hover { background-color: #FF5200; }
        .procore-orange-bg { background-color: #FF5200; }
        
        /* Ensure specific banner elements are left-aligned, not centered */
        /* REMOVED UNUSED .banner-content-container CSS */
        
        /* New styles for collapsible content */
        .collapsible-content {
            overflow: hidden;
            max-height: 0;
            transition: max-height 0.5s ease-in-out;
        }
        .collapsible-content.open {
            max-height: 5000px; /* Sufficiently large value for smooth transition */
        }
        .collapsible-button .dropdown-icon {
            transition: transform 0.3s ease;
        }
        /* UPDATED: Arrow icon for the OPEN state (e.g., Procore Enterprise Tools) */
        .collapsible-button.open .dropdown-icon {
            transform: rotate(45deg); /* 45 degrees down/right */
        }

        /* Interview specific styling */
        .interview-content h4 {
            font-size: 1.25rem; /* text-xl */
            font-weight: 700; /* font-bold */
            color: #ECE0D6; /* Procore Stone - Default Text */
            margin-top: 1.5rem;
            margin-bottom: 0.5rem;
        }
        /* Style for workstream sub-headings */
        .workstream-card h3 {
            color: #ECE0D6; /* Procore Stone - Default Text */
        }

        /* Custom style for the circular image */
        .spotlight-image {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            margin-bottom: 1.5rem;
            border: 4px solid #FF5200; /* Procore Orange border */
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);
        }
        /* Style for the new emoji learning tiles */
        .emoji-icon {
            font-size: 2.5rem; /* Large emoji size */
        }
        
        /* --- NEW AI CARD STYLES --- */
        .ai-card {
            position: relative;
            min-height: 400px;
            background-size: cover;
            background-position: center;
            border-radius: 0.75rem; /* rounded-xl */
            box-shadow: 0 10px 15px rgba(0, 0, 0, 0.5);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            overflow: hidden; /* Ensure image and overlay stay within rounded corners */
            display: flex; /* Helps ensure content stays at the bottom */
            flex-direction: column;
            justify-content: flex-end;
        }
        .ai-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 20px rgba(0, 0, 0, 0.7);
        }
        .ai-card-overlay {
            position: absolute;
            inset: 0;
            /* Dark gradient from bottom up */
            background: linear-gradient(to top, rgba(0, 0, 0, 0.8) 0%, rgba(0, 0, 0, 0) 50%);
        }
        .ai-card-content {
            position: relative; /* Position relative to overlay/card for stacking context */
            z-index: 10;
            padding: 1.5rem; /* p-6 */
            color: white;
            width: 100%;
        }
        
        /* Custom arrow style matching the user's image */
        .ai-card-arrow {
            width: 48px;
            height: 48px;
            background-color: #FF5200; /* Procore Orange */
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background-color 0.3s ease;
        }
        .ai-card:hover .ai-card-arrow {
            background-color: #CC4400; /* Slightly darker orange on hover */
        }
        .ai-card-arrow svg {
            color: white;
            width: 24px;
            height: 24px;
        }
        
        /* Custom icon colors for the table - NOW USED AS BACKGROUND FOR SVGs */
        .adobe-icon-bg, .atlassian-icon-bg, .loom-icon-bg, .slack-icon-bg, .zoom-icon-bg, .google-icon-bg { 
            background-color: #ffffff; /* Universal White Background for Visibility */
        }
        
        /* --- UPDATED Custom Table Icon Styling with Bevel and Border --- */
        .table-icon-container {
            /* INCREASED SIZE */
            width: 44px; 
            height: 44px;
            border-radius: 50%; /* This makes the container a circle */
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 0.75rem;
            flex-shrink: 0;
            
            /* NEW: Small white outline/border */
            border: 2px solid #ffffff; 
            
            /* NEW: Beveled 3D look (subtle inset shadow for effect, no orange) */
            box-shadow: 
                inset 0 2px 4px rgba(255, 255, 255, 0.5), /* Highlight top-left */
                inset 0 -2px 4px rgba(0, 0, 0, 0.4),     /* Shadow bottom-right */
                0 4px 6px rgba(0, 0, 0, 0.2);            /* Lift shadow */
        }
        .table-icon-img {
            /* STRETCH THE IMAGE TO FILL ALMOST THE ENTIRE INNER SPACE */
            width: 90%; 
            height: 90%;
            /* object-fit: contain is kept to respect aspect ratio, but the increased size achieves the goal */
            object-fit: contain;
            /* FIX: Ensure the image itself is clipped to a circle within the container */
            border-radius: 50%; 
        }
        /* --- END UPDATED Custom Table Icon Styling --- */
        
        /* Custom link style in table */
        .table-link {
            color: #FF5200;
            text-decoration: underline;
            transition: color 0.2s;
        }
        .table-link:hover {
            color: #ECE0D6;
        }

        /* --- NEW: LRC Information Library Hover Effect (Shadow Glow Removed) --- */
        .lrc-library-button {
            transition: transform 0.2s ease, background-color 0.2s ease;
        }
        .lrc-library-button:hover {
            transform: scale(1.05);
            /* Removed box-shadow */
            background-color: #4B5563; /* Gray hover color similar to Unlocking AI button */
        }
        
        /* Style for the new Legal-Specific Resources section */
        .legal-specific-card {
            min-height: 250px;
            background-color: #1a1a1a;
            border: 1px solid #333;
            border-radius: 0.75rem;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
            transition: background-color 0.2s;
        }
        .legal-specific-card:hover {
            background-color: #2a2a2a;
        }
        
        /* Consistent styling for the Company AI Updates block to match Procore Enterprise Tools block */
        .company-ai-updates-block {
            border: 1px solid #333;
            border-radius: 0.75rem; /* rounded-xl */
            padding: 1rem; /* p-4 */
            transition: background-color 0.2s;
        }
        .company-ai-updates-block:hover {
            background-color: #1a1a1a; /* Subtle hover effect */
        }
        
        /* NEW ICON BACKGROUND COLOR FOR COMPANY AI UPDATES */
        .company-ai-icon-bg {
            background-color: #566578; /* Procore Metal Gray */
        }
        /* UPDATED ICON BACKGROUND COLOR FOR LEGAL TECH TOOLS (Procore Gold) */
        .legal-tech-icon-bg {
            background-color: #CEC4A1; /* Procore Gold */
        }
        /* NEW ICON BACKGROUND COLOR FOR LEGAL TOPICS (Earth/Stone color for documentation/trends) */
        .legal-trends-icon-bg {
            background-color: #8D6E5B; /* Earth color */
        }

        /* --- NEW PROJECT CARD ICON STYLES (Used to be dark theme) --- */
        .project-icon-container {
            width: 56px; 
            height: 56px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 1.5rem;
            flex-shrink: 0;
            margin-bottom: 1rem;
        }
        .project-icon-img {
            width: 30px; 
            height: 30px;
            object-contain: contain;
        }
        .blueprint-bg {
            background-color: #3498DB; /* Blue for blueprint/planning */
        }
        .excavator-bg {
            background-color: #A0522D; /* Sienna/Earth tone for equipment */
        }
        /* --- END NEW PROJECT CARD ICON STYLES --- */

        /* --- NEW LIGHT/ARTICLE THEME --- */
        .light-article-section {
            /* CHANGED FROM #ffffff TO SLIGHTLY GRAYER TONE */
            background-color: #EAEAEA; /* Slightly grayer tone for articles */
            color: #000000; /* Dark text for contrast */
            border-radius: 0.75rem;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1); /* Subtle shadow for lift */
        }
        .light-article-section h3 {
            font-size: 1.875rem; /* text-3xl for prominence */
            font-weight: 800; /* Extra bold */
            margin-bottom: 0.5rem;
            color: #000000; /* Black headline */
        }
        .light-article-section p, .light-article-section li {
            color: #333333; /* Dark gray body text */
        }
        .key-feature-subheading {
            font-size: 1rem; /* Base text size for subheads */
            font-weight: 600; /* Semibold */
            color: #FF5200; /* Procore Orange for differentiation */
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-top: 1.5rem;
            margin-bottom: 0.5rem;
            /* Added line to separate features */
            border-bottom: 1px solid #e5e7eb; /* Light gray line */
            padding-bottom: 0.5rem;
        }
        .article-topic-label {
            font-size: 0.875rem; /* text-sm */
            font-weight: 600; /* Semibold */
            color: #6b7280; /* Gray text for category label */
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 0.25rem;
            display: block;
        }
        /* New style for beveled icons (used for Key Benefits/Outcome) */
        .beveled-icon-container {
            /* Emulate a 3D beveled effect */
            width: 32px;
            height: 32px;
            border-radius: 6px; /* Slightly rounded square/rectangle */
            background: #FF5200; /* Procore Orange base */
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 0.75rem;
            flex-shrink: 0;
            /* Soft 3D/Bevel look */
            box-shadow: 
                inset 0 2px 4px rgba(255, 255, 255, 0.5), /* Highlight top-left */
                inset 0 -2px 4px rgba(0, 0, 0, 0.3), /* Shadow bottom-right */
                0 4px 6px rgba(0, 0, 0, 0.2); /* Lifted shadow */
        }
        .beveled-icon-container svg {
            width: 18px;
            height: 18px;
            /* Slight offset to make the icon look inset */
            transform: translate(0, 0); 
            filter: drop-shadow(0 1px 1px rgba(0,0,0,0.5));
        }
        /* --- END NEW LIGHT/ARTICLE THEME --- */
        
        /* New styling for the section divider differentiator text (left justified) */
        .section-differentiator {
            text-align: left;
            font-size: 0.75rem; /* text-xs */
            color: #ECE0D6; /* UPDATED: Brighter font color for visibility */
            text-transform: uppercase;
            letter-spacing: 0.1em; /* tracking-widest */
            margin-bottom: 0.5rem; /* mb-2 - Reduced spacing to place closer to H2 */
            padding-top: 1rem; /* py-4 */
        }
        
        /* Custom styles for the highlighted quote block */
        .highlighted-quote {
            background-color: #1f2937; /* bg-gray-800 */
            color: #d1d5db; /* text-gray-300 */
        }
        .highlighted-quote .quote-bar {
            background-color: #FF5200; /* Procore Orange */
        }
        /* Custom styles for the background text in the featured cards (LRC Learning) */
        .featured-card-text {
            font-size: 1.25rem; /* reduced from 2xl to xl for subtlety */
        }
        
        /* UPDATED: Increased Quote Text Size */
        .highlighted-quote p {
            font-size: 1.25rem; /* text-xl for more prominence */
            font-style: italic;
        }
        
        /* --- Custom Positioning for LexisNexis Protege+ image (SVG) --- */
        .protege-card {
            background-size: 50% auto !important; /* Adjust size to fit in center */
            background-repeat: no-repeat !important;
        }

        /* --- Custom Styling for Internal Build Card --- */
        .internal-build-card {
            background-color: #2a2a2a;
            border: 2px solid #FF5200; /* Procore Orange outline */
            box-shadow: 0 0 15px rgba(255, 82, 0, 0.4); /* Subtle orange glow */
        }
        
        /* NEW: Custom Learning Icon Styling */
        .learning-icon-container {
            /* Background colors: Green/Teal, Purple, Orange */
            background: linear-gradient(135deg, #4CAF50 0%, #03A9F4 50%, #FF5200 100%);
            width: 64px;
            height: 64px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 8px;
            flex-shrink: 0;
        }
        .learning-icon-container svg {
            width: 32px;
            height: 32px;
            color: white;
            filter: drop-shadow(0 1px 1px rgba(0,0,0,0.5));
        }
        
        /* --- NEW TAB/NAVIGATION STYLES (for Legal Innovation Center) --- */
        .tab-button {
            transition: all 0.2s;
            border-bottom: 2px solid transparent;
            font-weight: 600; /* Semi-bold */
        }
        .tab-button:hover {
            background-color: #1f2937; /* Gray-800 hover effect */
        }
        .tab-button.active {
            border-bottom: 2px solid #FF5200; /* Procore Orange active indicator */
            color: #FF5200; /* Active text color */
        }
        .tab-content {
            padding-top: 1.5rem;
            /* Hide by default, controlled by JS toggleTab */
            display: none; 
        }
        
    </style>
</head>
