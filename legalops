    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #000000;
            color: #ECE0D6;
            scroll-behavior: smooth;
        }
        .nav-item-button:hover .dropdown-icon {
            transform: rotate(180deg);
        }
        .nav-item-button {
            transition: background-color 0.2s, transform 0.2s;
        }
        .dropdown-icon {
            transition: transform 0.3s ease;
        }
        #mobile-menu {
            transition: max-height 0.3s ease-out, opacity 0.3s ease-out;
            max-height: 0;
            overflow: hidden;
            opacity: 0;
        }
        #mobile-menu.open {
            max-height: 500px;
            opacity: 1;
        }
        .header-dropdown-menu {
            width: 300px;
            background-color: #111827;
            border-radius: 0.75rem;
            box-shadow: 0 10px 15px rgba(0, 0, 0, 0.5);
        }
        .dropdown-header {
            padding: 1rem 1.5rem;
            border-bottom: 1px solid #1f2937;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .dropdown-header-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: #ffffff;
        }
        .dropdown-link {
            display: block;
            padding: 0.75rem 1.5rem;
            font-size: 1rem;
            color: #ffffff;
            transition: background-color 0.2s;
        }
        .dropdown-link:hover {
            background-color: #1f2937;
        }
        .nested-dropdown-button {
            padding: 0.75rem 1.5rem;
        }
        .nested-dropdown-content a {
            padding: 0.5rem 2rem;
            display: block;
        }
        #carousel-canvas {
            display: block;
            width: 100%;
            height: 100%;
        }
        #banner-overlay-text {
            background-color: rgba(0, 0, 0, 0.4);
        }
        .procore-orange-text { color: #FF5200; }
        .hover-procore-orange-bg:hover { background-color: #FF5200; }
        .procore-orange-bg { background-color: #FF5200; }
        .collapsible-content {
            overflow: hidden;
            max-height: 0;
            transition: max-height 0.5s ease-in-out;
        }
        .collapsible-content.open {
            max-height: 5000px;
        }
        .collapsible-button .dropdown-icon {
            transition: transform 0.3s ease;
        }
        .collapsible-button.open .dropdown-icon {
            transform: rotate(45deg);
        }
        .interview-content h4 {
            font-size: 1.25rem;
            font-weight: 700;
            color: #ECE0D6;
            margin-top: 1.5rem;
            margin-bottom: 0.5rem;
        }
        .workstream-card h3 {
            color: #ECE0D6;
        }
        .spotlight-image {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            margin-bottom: 1.5rem;
            border: 4px solid #FF5200;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);
        }
        .emoji-icon {
            font-size: 2.5rem;
        }
        .ai-card {
            position: relative;
            min-height: 400px;
            background-size: cover;
            background-position: center;
            border-radius: 0.75rem;
            box-shadow: 0 10px 15px rgba(0, 0, 0, 0.5);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
        }
        .ai-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 20px rgba(0, 0, 0, 0.7);
        }
        .ai-card-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(to top, rgba(0, 0, 0, 0.8) 0%, rgba(0, 0, 0, 0) 50%);
        }
        .ai-card-content {
            position: relative;
            z-index: 10;
            padding: 1.5rem;
            color: white;
            width: 100%;
        }
        .ai-card-arrow {
            width: 48px;
            height: 48px;
            background-color: #FF5200;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background-color 0.3s ease;
        }
        .ai-card:hover .ai-card-arrow {
            background-color: #CC4400;
        }
        .ai-card-arrow svg {
            color: white;
            width: 24px;
            height: 24px;
        }
        .adobe-icon-bg, .atlassian-icon-bg, .loom-icon-bg, .slack-icon-bg, .zoom-icon-bg, .google-icon-bg {
            background-color: #ffffff;
        }
        .table-icon-container {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 0.75rem;
            flex-shrink: 0;
            border: 2px solid #ffffff;
            box-shadow:
                inset 0 2px 4px rgba(255, 255, 255, 0.5),
                inset 0 -2px 4px rgba(0, 0, 0, 0.4),
                0 4px 6px rgba(0, 0, 0, 0.2);
        }
        .table-icon-img {
            width: 90%;
            height: 90%;
            object-fit: contain;
            border-radius: 50%;
        }
        .table-link {
            color: #FF5200;
            text-decoration: underline;
            transition: color 0.2s;
        }
        .table-link:hover {
            color: #ECE0D6;
        }
        .lrc-library-button {
            transition: transform 0.2s ease, background-color 0.2s ease;
        }
        .lrc-library-button:hover {
            transform: scale(1.05);
            background-color: #4B5563;
        }
        .legal-specific-card {
            min-height: 250px;
            background-color: #1a1a1a;
            border: 1px solid #333;
            border-radius: 0.75rem;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
            transition: background-color 0.2s;
        }
        .legal-specific-card:hover {
            background-color: #2a2a2a;
        }
        .company-ai-updates-block {
            border: 1px solid #333;
            border-radius: 0.75rem;
            padding: 1rem;
            transition: background-color 0.2s;
        }
        .company-ai-updates-block:hover {
            background-color: #1a1a1a;
        }
        .company-ai-icon-bg {
            background-color: #566578;
        }
        .legal-tech-icon-bg {
            background-color: #CEC4A1;
        }
        .legal-trends-icon-bg {
            background-color: #8D6E5B;
        }
        .project-icon-container {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 1.5rem;
            flex-shrink: 0;
            margin-bottom: 1rem;
        }
        .project-icon-img {
            width: 30px;
            height: 30px;
            object-contain: contain;
        }
        .blueprint-bg {
            background-color: #3498DB;
        }
        .excavator-bg {
            background-color: #A0522D;
        }
        .light-article-section {
            background-color: #EAEAEA;
            color: #000000;
            border-radius: 0.75rem;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        }
        .light-article-section h3 {
            font-size: 1.875rem;
            font-weight: 800;
            margin-bottom: 0.5rem;
            color: #000000;
        }
        .light-article-section p, .light-article-section li {
            color: #333333;
        }
        .key-feature-subheading {
            font-size: 1rem;
            font-weight: 600;
            color: #FF5200;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-top: 1.5rem;
            margin-bottom: 0.5rem;
            border-bottom: 1px solid #e5e7eb;
            padding-bottom: 0.5rem;
        }
        .article-topic-label {
            font-size: 0.875rem;
            font-weight: 600;
            color: #6b7280;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 0.25rem;
            display: block;
        }
        .beveled-icon-container {
            width: 32px;
            height: 32px;
            border-radius: 6px;
            background: #FF5200;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 0.75rem;
            flex-shrink: 0;
            box-shadow:
                inset 0 2px 4px rgba(255, 255, 255, 0.5),
                inset 0 -2px 4px rgba(0, 0, 0, 0.3),
                0 4px 6px rgba(0, 0, 0, 0.2);
        }
        .beveled-icon-container svg {
            width: 18px;
            height: 18px;
            transform: translate(0, 0);
            filter: drop-shadow(0 1px 1px rgba(0,0,0,0.5));
        }
        .section-differentiator {
            text-align: left;
            font-size: 0.75rem;
            color: #ECE0D6;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            margin-bottom: 0.5rem;
            padding-top: 1rem;
        }
        .highlighted-quote {
            background-color: #1f2937;
            color: #d1d5db;
        }
        .highlighted-quote .quote-bar {
            background-color: #FF5200;
        }
        .featured-card-text {
            font-size: 1.25rem;
        }
        .highlighted-quote p {
            font-size: 1.25rem;
            font-style: italic;
        }
        .protege-card {
            background-size: 50% auto !important;
            background-repeat: no-repeat !important;
        }
        .internal-build-card {
            background-color: #2a2a2a;
            border: 2px solid #FF5200;
            box-shadow: 0 0 15px rgba(255, 82, 0, 0.4);
        }
        .learning-icon-container {
            background: linear-gradient(135deg, #4CAF50 0%, #03A9F4 50%, #FF5200 100%);
            width: 64px;
            height: 64px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 8px;
            flex-shrink: 0;
        }
        .learning-icon-container svg {
            width: 32px;
            height: 32px;
            color: white;
            filter: drop-shadow(0 1px 1px rgba(0,0,0,0.5));
        }
        .tab-button {
            transition: all 0.2s;
            border-bottom: 2px solid transparent;
            font-weight: 600;
        }
        .tab-button:hover {
            background-color: #1f2937;
        }
        .tab-button.active {
            border-bottom: 2px solid #FF5200;
            color: #FF5200;
        }
        .tab-content {
            padding-top: 1.5rem;
            display: none;
        }
        /* New style for Rovo Chat Sidebar */
        #rovo-chat-sidebar {
            position: fixed;
            top: 0;
            left: 0;
            z-index: 60; /* Higher than header (z-50) */
            width: 380px; /* Width for the sidebar */
            height: 100vh;
            background-color: #111827; /* Dark background */
            box-shadow: 4px 0 10px rgba(0, 0, 0, 0.5);
            transform: translateX(-100%);
            transition: transform 0.3s ease-out;
        }
        #rovo-chat-sidebar.open {
            transform: translateX(0);
        }
        @media (max-width: 640px) { /* Adjust for mobile */
            #rovo-chat-sidebar {
                width: 100%;
            }
        }
        /* Style for the iframe inside the sidebar */
        #rovo-iframe {
            width: 100%;
            height: calc(100vh - 64px); 
            border: none;
        }
        .rovo-icon-bg {
            background-color: #0052CC; /* Atlassian Blue/Rovo Blue */
        }
    </style>
