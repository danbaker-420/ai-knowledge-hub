<script>
    // --- THREE.JS LOGIC FOR DYNAMIC BANNER BACKGROUND ---
    let renderer, camera, scene, cubes = [];
    const textureLoader = new THREE.TextureLoader();
    let backgroundPlane; 
    
    // Custom assets matching Procore theme
    const backgroundImage = 'https://placehold.co/1200x600/FF5200/FF5200?text=Procore+Orange'; 
    const patentDiagramUrl = 'https://placehold.co/2000x240/1A1A1A/1A1A1A?text=ABSTRACT+CONSTRUCTION+PLAN'; // Darker watermark for subtlety

    function getBannerHeight() {
        // Retrieve explicit height from the HTML element's inline style
        const wrapper = document.getElementById('banner-canvas-wrapper');
        if (wrapper && wrapper.style.height) {
            // MODIFIED: Reduced base height to 350px in HTML
            return parseFloat(wrapper.style.height); 
        }
        // MODIFIED: Updated default fallback height
        return 350; 
    }

    function updateCanvasSize() {
        const canvas = document.getElementById('carousel-canvas');
        if (!canvas) return;
        
        const newWidth = canvas.parentElement ? canvas.parentElement.clientWidth : window.innerWidth;
        const newHeight = getBannerHeight(); 
        
        if (renderer && camera) {
            renderer.setSize(newWidth, newHeight);
            camera.aspect = newWidth / newHeight;
            camera.updateProjectionMatrix();
        }
    }
    
    function initCarousel() {
        const canvas = document.getElementById('carousel-canvas');
        if (!canvas) return;

        const initialHeight = getBannerHeight(); 

        scene = new THREE.Scene();
        // Set Procore Orange as the initial fallback background color
        scene.background = new THREE.Color(0xFF5200); 

        // Initialize camera
        camera = new THREE.PerspectiveCamera(75, canvas.clientWidth / initialHeight, 0.1, 1000);
        camera.position.z = 5.5; 

        renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true, alpha: true });
        
        updateCanvasSize(); 

        // Lights
        const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
        scene.add(ambientLight);
        // FIX: Corrected typo from THREE.DirectionionalLight to THREE.DirectionalLight
        const directionalLight = new THREE.DirectionalLight(0xffffff, 0.8);
        directionalLight.position.set(0, 5, 5);
        scene.add(directionalLight);
        
        
        // 1. Set Primary Background to Texture (Procore Orange)
        textureLoader.load(backgroundImage, 
            function(texture) {
                texture.colorSpace = THREE.SRGBColorSpace;
                scene.background = texture;
            },
            undefined,
            function(err) {
                console.error('Error loading background image:', err);
                // Ensure orange fallback on texture load failure
                scene.background = new THREE.Color(0xFF5200); 
            }
        );
        
        // 2. Watermark Layer (Abstract pattern in light gray for contrast)
        textureLoader.load(patentDiagramUrl, 
            function(texture) {
                texture.colorSpace = THREE.SRGBColorSpace;
                
                const backgroundGeometry = new THREE.PlaneGeometry(20, 10); 
                const backgroundMaterial = new THREE.MeshBasicMaterial({
                    map: texture,
                    transparent: true,
                    opacity: 0.3, 
                    side: THREE.DoubleSide
                });

                backgroundPlane = new THREE.Mesh(backgroundGeometry, backgroundMaterial);
                backgroundPlane.position.z = -1; 
                backgroundPlane.rotation.z = -Math.PI * 0.05; 
                backgroundPlane.position.y = -1;
                scene.add(backgroundPlane);
            },
            undefined,
            function(err) {
                console.error('Error loading patent diagram texture:', err);
            }
        );

        // Cube Definitions (Abstract concepts)
        const excitingAreas = [
            { title: "Legal Tech", color: 0xff5200, position: -1.8 }, 
            { title: "Process", color: 0x000000, position: 0.0 }, 
            { title: "Strategy", color: 0xff5200, position: 1.8 }
        ];

        const width = 2.0, height = 3.0, depth = 0.8, segments = 10; 

        excitingAreas.forEach((area) => {
            const cubeGeometry = new THREE.BoxGeometry(width, height, depth, segments, segments, segments);
            cubeGeometry.computeVertexNormals(); 
            
            // Darker colors for the 3D objects
            const materialColor = area.color === 0x000000 ? 0x222222 : 0xcc4400; 
            const material = new THREE.MeshPhongMaterial({ 
                color: materialColor, 
                emissive: materialColor, 
                emissiveIntensity: 0.2, 
                shininess: 80, 
                specular: 0xcccccc 
            });
            
            const cube = new THREE.Mesh(cubeGeometry, material);
            
            cube.position.x = area.position;
            cube.userData.rotationSpeed = 0.01;
            cubes.push(cube);
            scene.add(cube);
        });
    }

    let animationFrameId;

    function animate() {
        animationFrameId = requestAnimationFrame(animate);

        if (backgroundPlane) {
            backgroundPlane.rotation.z += 0.0005; 
            backgroundPlane.position.x = Math.sin(Date.now() * 0.0001) * 0.5;
        }
        
        cubes.forEach(cube => {
            cube.rotation.y += cube.userData.rotationSpeed * 0.5;
            cube.rotation.x += cube.userData.rotationSpeed / 4; 
            cube.rotation.z += cube.userData.rotationSpeed / 8;
            
            cube.updateMatrixWorld(true);
            
            // Subtle pulsing scale animation
            const scaleFactor = 1 + Math.sin(Date.now() * 0.001 * cube.userData.rotationSpeed * 20) * 0.03;
            cube.scale.x = cube.scale.y = cube.scale.z = scaleFactor;
        });

        if (renderer) {
            renderer.render(scene, camera);
        }
    }

    function onWindowResize() {
        updateCanvasSize();
    }
    // --- END THREE.JS LOGIC ---

    // --- UTILITY CLEANUP FUNCTION (UPDATED) ---
    function toggleDropdownCleanup(excludeMenuId = null) {
        // Close all desktop dropdowns (standard and explore)
        document.querySelectorAll('.header-dropdown-menu').forEach(menu => {
            // Only hide menus that are NOT the one we are excluding
            if (menu.id !== excludeMenuId) { 
                menu.classList.add('hidden');
            }
        });
        
        // Reset desktop dropdown icons
        document.querySelectorAll('.nav-item-button .dropdown-icon').forEach(icon => {
            // Reset icon rotation if it belongs to a main toggle button
            if (icon.closest('button') && (icon.closest('button').id.startsWith('dropdown-toggle') || icon.closest('button').id === 'header-explore-toggle')) {
                icon.style.transform = 'rotate(0deg)';
            }
        });
        
        // Reset nested explore icons
        document.querySelectorAll('#header-icon-2a, #header-icon-2b').forEach(icon => {
            icon.style.transform = 'rotate(0deg)';
        });
    }
    // --- END UTILITY CLEANUP FUNCTION ---


    // --- MAIN SCRIPT LOGIC (Dropdown, Mobile Menu, Collapsible, Explore, Tabs) ---

    /**
     * Toggles the visibility of a specified dropdown menu (used for header nav).
     */
    function toggleDropdown(menuId, button) {
        const menu = document.getElementById(menuId);
        const icon = button.querySelector('.dropdown-icon');
        
        // Determine if the menu is currently OPEN before cleanup
        const wasOpen = !menu.classList.contains('hidden');
        
        // 1. Cleanup: Close all OTHER menus except the one being clicked
        toggleDropdownCleanup(menuId); 

        // 2. Toggle the current menu's visibility and icon state
        if (wasOpen) {
            // If it was open, close it
            menu.classList.add('hidden');
            icon.style.transform = 'rotate(0deg)';
        } else {
            // If it was closed, open it
            menu.classList.remove('hidden');
            icon.style.transform = 'rotate(180deg)';
        }
    }

    /**
     * Toggles the mobile menu for small screens.
     */
    function toggleMobileMenu() {
        const mobileMenu = document.getElementById('mobile-menu');
        const openIcon = document.getElementById('menu-open-icon');
        const closeIcon = document.getElementById('menu-close-icon');

        const isOpen = mobileMenu.classList.toggle('open');
        
        openIcon.classList.toggle('hidden', isOpen);
        closeIcon.classList.toggle('hidden', !isOpen);

        mobileMenu.setAttribute('aria-expanded', isOpen);

        if (!isOpen) {
            document.querySelectorAll('.bg-gray-800[id^="mobile-dropdown-menu-"]').forEach(subDropdown => {
                subDropdown.classList.add('hidden');
            });
        }
    }

    /**
     * Toggles the visibility of a collapsible section.
     */
    function toggleCollapsible(contentId, button) {
        const content = document.getElementById(contentId);
        if (content) {
            const isOpening = !content.classList.contains('open');
            
            content.classList.toggle('open');
            button.classList.toggle('open');
            button.setAttribute('aria-expanded', isOpening);
        }
    }

    /**
     * Toggles the visibility of a main Explore menu (Level 1).
     */
    function toggleExploreDropdown(menuId, button) {
        const menu = document.getElementById(menuId);
        const mainIcon = button.querySelector('.dropdown-icon');
        
        // 1. Determine current state
        const wasOpen = !menu.classList.contains('hidden');

        // 2. Cleanup: Close all OTHER menus (including standard dropdowns)
        toggleDropdownCleanup(menuId); 

        // 3. Toggle the current menu's visibility and rotation
        if (wasOpen) {
            // If it was open, close it
            menu.classList.add('hidden');
            mainIcon.style.transform = 'rotate(0deg)';
            
            // Also close its children menus and reset icons when closing the parent
            document.querySelectorAll('#header-explore-menu-2a, #header-explore-menu-2b').forEach(m => m.classList.add('hidden'));
            document.querySelectorAll('#header-icon-2a, #header-icon-2b').forEach(icon => icon.style.transform = 'rotate(0deg)');
            
        } else {
            // If it was closed, open it
            menu.classList.remove('hidden');
            mainIcon.style.transform = 'rotate(180deg)';
            
            // Ensure child menus are closed when opening the main menu
            document.querySelectorAll('#header-explore-menu-2a, #header-explore-menu-2b').forEach(m => m.classList.add('hidden'));
            document.querySelectorAll('#header-icon-2a, #header-icon-2b').forEach(icon => icon.style.transform = 'rotate(0deg)');
        }
    }

    /**
     * Scrolls to a specific section and handles menu cleanup.
     * Used for non-tab-related links (e.g., Back to Top, Team News Link).
     */
    function scrollToSection(targetId, event = null, doScroll = true) {
        if (event && typeof event.preventDefault === 'function') {
            event.preventDefault();
        }
        
        // 1. Cleanup dropdowns/mobile menu
        toggleDropdownCleanup();
        const mobileMenu = document.getElementById('mobile-menu');
        if (mobileMenu && mobileMenu.classList.contains('open')) {
            toggleMobileMenu();
        }

        // 2. Perform smooth scroll (CSS handles 'smooth')
        if (doScroll) {
            const targetElement = document.getElementById(targetId);
            if (targetElement) {
                targetElement.scrollIntoView({
                    behavior: 'smooth',
                    block: 'start'
                });
            } else if (targetId === 'top-of-page') {
                window.scrollTo({
                    top: 0,
                    behavior: 'smooth'
                });
            }
        }
    }
    

    /**
     * Toggles between content tabs (workstreams, trends, tools/trials).
     * This function should now only swap content, fixing the page jump.
     */
    function toggleTab(contentId, button, doScroll = false, event = null) {
        
        // 1. Prevent default link behavior for menu links
        if (event && typeof event.preventDefault === 'function') {
            event.preventDefault(); 
        }
        
        // 2. Find parent section
        const parentSection = button.closest('section');
        if (!parentSection) return;
        const parentSectionId = parentSection.id;

        // 3. Hide all tab content
        document.querySelectorAll(`#${parentSectionId} .tab-content`).forEach(content => {
            content.style.display = 'none';
        });

        // 4. Deactivate all tab buttons
        document.querySelectorAll(`#${parentSectionId} .tab-button`).forEach(btn => {
            btn.classList.remove('active', 'text-white');
            btn.classList.add('text-gray-400');
            btn.setAttribute('aria-selected', 'false');
        });

        // 5. Show the selected content and activate the button
        const selectedContent = document.getElementById(contentId);
        if (selectedContent) {
            selectedContent.style.display = 'block';
            button.classList.add('active', 'text-white');
            button.classList.remove('text-gray-400');
            button.setAttribute('aria-selected', 'true');
        }
        
        // The previous attempt at solving the jump issue by forcing a scroll here is now intentionally removed.
    }

    /**
     * Handler for nested desktop navigation clicks. Scrolls to the section, then activates the tab.
     */
    function handleNavTabClick(sectionId, buttonId, contentId, event) {
        if (event && typeof event.preventDefault === 'function') {
            event.preventDefault();
        }

        const targetElement = document.getElementById(sectionId);
        const tabButton = document.getElementById(buttonId);

        if (targetElement && tabButton) {
            
            // 1. Cleanup dropdowns/mobile menu
            toggleDropdownCleanup();
            
            // 2. Perform smooth scroll to the section (this is intended for navigation)
            targetElement.scrollIntoView({ behavior: 'smooth', block: 'start' });

            // 3. Toggle the tab state immediately after scroll initiation 
            toggleTab(contentId, tabButton, false); 
        }
    }


    /**
     * Toggles the visibility of a nested explore menu (Level 2).
     */
    function toggleExploreSubDropdown(menuId, button) {
        const menu = document.getElementById(menuId);
        const icon = button.querySelector('svg');
        
        // Find the other Level 2 menu ID in the same section
        let otherMenuId = '';
        if (menuId.endsWith('2a')) {
            otherMenuId = menuId.replace('2a', '2b');
        } else if (menuId.endsWith('2b')) {
            otherMenuId = menuId.replace('2b', '2a');
        }

        // Close the other Level 2 menu
        const otherMenu = document.getElementById(otherMenuId);
        if (otherMenu && !otherMenu.classList.contains('hidden')) {
            otherMenu.classList.add('hidden');
            // Find the other icon and reset its rotation
            const otherIconId = otherMenuId.replace('menu', 'icon');
            const otherIcon = document.getElementById(otherIconId);
            if (otherIcon) otherIcon.style.transform = 'rotate(0deg)';
        }

        // Toggle the current menu
        const isHidden = menu.classList.toggle('hidden');

        // Rotate the current icon
        if (!isHidden) {
            icon.style.transform = 'rotate(90deg)';
        } else {
            icon.style.transform = 'rotate(0deg)';
        }
    }

    // --- EVENT LISTENERS ---

    /**
     * Closes desktop dropdowns if the user clicks anywhere else on the document.
     */
    document.addEventListener('click', (event) => {
        // Elements that should keep the dropdown open if clicked
        const isHeaderButton = event.target.closest('button[id^="dropdown-toggle-"]') || event.target.closest('#header-explore-toggle');
        const isHeaderDropdownContent = event.target.closest('.header-dropdown-menu');
        
        if (!isHeaderButton && !isHeaderDropdownContent) {
            toggleDropdownCleanup();
        }
    });

    document.addEventListener('DOMContentLoaded', () => {
        // --- Custom Handler for All Internal Anchor Links ---
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            // Check if the link already has an explicit onclick handler (which handles scrolling/tabs)
            if (anchor.getAttribute('onclick')) {
                return; 
            }
            
            const href = anchor.getAttribute('href');
            const targetId = href.substring(1);

            // Only proceed if it's an internal hash link that points to an existing element ID
            if (href.length > 1 && href.startsWith('#') && document.getElementById(targetId)) {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault(); 
                    scrollToSection(targetId);
                });
            }
        });
        
        // --- Initial Tab Load: Set the default tabs to open on load ---
        
        // Default Legal Tab (Our AI Work Streams) - doScroll: false
        const defaultLegalTabButton = document.getElementById('workstreams-tab-button');
        if (defaultLegalTabButton) {
            // Note: This needs to be called after the DOM is fully loaded but BEFORE the page loads external resources.
            // Using a simple call here, relying on the clean toggleTab function.
            toggleTab('workstreams-tab-content', defaultLegalTabButton, false); 
        }
        
        // Default Enterprise Tab (Corporate Productivity AI Updates) - doScroll: false
        const defaultEnterpriseTabButton = document.getElementById('updates-tab-button');
        if (defaultEnterpriseTabButton) {
            toggleTab('updates-tab-content', defaultEnterpriseTabButton, false); 
        }

        // Default Spotlight Tab (LRC Strategic Projects) - doScroll: false
        const defaultSpotlightTabButton = document.getElementById('spotlight-projects-tab-button');
        if (defaultSpotlightTabButton) {
            toggleTab('spotlight-projects-tab-content', defaultSpotlightTabButton, false); 
        }
        
    });


    // Initialize Three.js on load and set up resize listener
    window.onload = function() {
        window.addEventListener('resize', onWindowResize);
        initCarousel();
        animate();
    };

</script>

</body>
</html>

