    <!-- JAVASCRIPT LOGIC (Dropdown, Collapsible, Search, and 3D Banner) -->
    <!-- ---------------------------------------------------- -->
    <script>
        let renderer, camera, scene, cubes = [];
        let backgroundPlane; 
        const textureLoader = new THREE.TextureLoader();
        
        // Use the colors/urls from the desired banner background (Procore Orange + Light Gray pattern)
        const backgroundImage = 'https://placehold.co/1200x240/ff5200/ff5200'; // Updated placeholder height
        const patentDiagramUrl = 'https://placehold.co/2000x240/D0D0D0/D0D0D0'; // Updated placeholder height
        const mainContent = document.querySelector('.main-content-wrapper');

        // NEW HELPER FUNCTION to get the numeric banner height from CSS variable
        function getBannerHeight() {
            const rootStyle = getComputedStyle(document.documentElement);
            // Extract the numeric value of --banner-height (e.g., '240px' -> 240)
            return parseFloat(rootStyle.getPropertyValue('--banner-height')) || 300; 
        }

        function updateCanvasSize() {
            const canvas = document.getElementById('carousel-canvas');
            const newWidth = mainContent ? mainContent.clientWidth : window.innerWidth;
            const newHeight = getBannerHeight(); // Use explicit height
            
            if (renderer && canvas) {
                renderer.setSize(newWidth, newHeight);
                camera.aspect = newWidth / newHeight;
                camera.updateProjectionMatrix();
            }
        }
        
        function initCarousel() {
            const canvas = document.getElementById('carousel-canvas');
            if (!canvas) return;

            // Use the explicit height from CSS variable for initialization
            const initialHeight = getBannerHeight(); 

            scene = new THREE.Scene();
            scene.background = new THREE.Color(0xff5200); 

            // Initialize camera using fixed height to ensure correct aspect ratio, even if canvas.offsetHeight is 0 momentarily
            camera = new THREE.PerspectiveCamera(75, canvas.clientWidth / initialHeight, 0.1, 1000);
            camera.position.z = 5.5; 

            renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true, alpha: true });
            
            updateCanvasSize(); 

            const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
            scene.add(ambientLight);
            const directionalLight = new THREE.DirectionalLight(0xffffff, 0.8);
            directionalLight.position.set(0, 5, 5);
            scene.add(directionalLight);
            
            
            // 1. SET PRIMARY BACKGROUND TO TEXTURE (Procore Orange)
            textureLoader.load(backgroundImage, 
                function(texture) {
                    texture.colorSpace = THREE.SRGBColorSpace;
                    scene.background = texture;
                },
                undefined,
                function(err) {
                    console.error('Error loading background image:', err);
                    scene.background = new THREE.Color(0xff5200); 
                }
            );
            
            // 2. RE-ADDED WATERMARK LAYER (Light Gray for contrast against orange)
            textureLoader.load(patentDiagramUrl, 
                function(texture) {
                    texture.colorSpace = THREE.SRGBColorSpace;
                    
                    const backgroundGeometry = new THREE.PlaneGeometry(20, 10); 
                    const backgroundMaterial = new THREE.MeshBasicMaterial({
                        map: texture,
                        transparent: true,
                        opacity: 0.3, 
                        side: THREE.DoubleSide
                    });

                    backgroundPlane = new THREE.Mesh(backgroundGeometry, backgroundMaterial);
                    backgroundPlane.position.z = -1; 
                    backgroundPlane.rotation.z = -Math.PI * 0.05; 
                    backgroundPlane.position.y = -1;
                    scene.add(backgroundPlane);
                },
                undefined,
                function(err) {
                    console.error('Error loading patent diagram texture:', err);
                }
            );

            // Cube Definitions
            const excitingAreas = [
                { title: "Legal Tech", color: 0xff5200, position: -1.8 }, 
                { title: "Process", color: 0x000000, position: 0.0 }, 
                { title: "Strategy", color: 0xff5200, position: 1.8 }
            ];

            const width = 2.0, height = 3.0, depth = 0.8, segments = 10; 

            excitingAreas.forEach((area) => {
                const cubeGeometry = new THREE.BoxGeometry(width, height, depth, segments, segments, segments);
                cubeGeometry.computeVertexNormals(); 
                
                const materialColor = area.color === 0x000000 ? 0x222222 : 0xf04400; 
                const material = new THREE.MeshPhongMaterial({ 
                    color: materialColor, 
                    emissive: materialColor, 
                    emissiveIntensity: 0.2, 
                    shininess: 80, 
                    specular: 0xcccccc 
                });
                
                const cube = new THREE.Mesh(cubeGeometry, material);
                
                cube.position.x = area.position;
                cube.userData.originalX = area.position;
                cube.userData.rotationSpeed = 0.01;
                cubes.push(cube);
                scene.add(cube);
            });
        }

        let animationFrameId;

        function animate() {
            animationFrameId = requestAnimationFrame(animate);

            if (backgroundPlane) {
                backgroundPlane.rotation.z += 0.0005; 
                backgroundPlane.position.x = Math.sin(Date.now() * 0.0001) * 0.5;
            }
            
            cubes.forEach(cube => {
                cube.rotation.y += cube.userData.rotationSpeed * 0.5;
                cube.rotation.x += cube.userData.rotationSpeed / 4; 
                cube.rotation.z += cube.userData.rotationSpeed / 8;
                
                cube.updateMatrixWorld(true);
                
                const scaleFactor = 1 + Math.sin(Date.now() * 0.001 * cube.userData.rotationSpeed * 20) * 0.03;
                cube.scale.x = cube.scale.y = cube.scale.z = scaleFactor;
            });

            if (renderer) {
                renderer.render(scene, camera);
            }
        }

        function onWindowResize() {
            updateCanvasSize();
        }

        document.addEventListener('DOMContentLoaded', () => {
            window.addEventListener('resize', onWindowResize);
            initCarousel();
            animate();

            // ------------------- SIDEBAR DROPDOWN LOGIC -------------------
            const setupSidebarDropdowns = () => {
                document.querySelectorAll('.sidenav .nav-link-item').forEach(root => {
                    const trigger = root.querySelector('.dropdown-trigger');
                    const dropdown = root.querySelector('.nav-dropdown');

                    if (trigger && dropdown) {
                        // Check if the item should be open by default (like the one we set to 'open' in HTML)
                        const isInitiallyOpen = root.classList.contains('open');

                        if (!isInitiallyOpen) {
                            dropdown.style.display = 'none';
                        } else {
                            // If marked as open, ensure display style is set correctly on load
                            dropdown.style.display = 'flex';
                        }
                        
                        trigger.addEventListener('click', function(event) {
                            event.stopPropagation();
                            const isOpening = !root.classList.contains('open');

                            if (isOpening) {
                                root.classList.add('open');
                                dropdown.style.display = 'flex'; 
                                
                            } else {
                                root.classList.remove('open');
                                dropdown.style.display = 'none';
                            }
                        });
                        
                        document.addEventListener('click', function(event) {
                            if (root.contains(event.target)) {
                                // If click is inside, let the trigger handle it or do nothing
                                return;
                            }
                            // Close if clicking outside the dropdown item (sidebar scope)
                            if (root.classList.contains('open')) {
                                root.classList.remove('open');
                                dropdown.style.display = 'none';
                            }
                        });
                    }
                });
            };
            
            setupSidebarDropdowns();
            // --- End Sidebar Dropdown Logic ---
            
            // --- Top Nav Click Logic (No Dropdowns) ---
            // Removed all top nav dropdown listeners as requested.

            // --- Collapsible Logic Function (USING DIRECT DISPLAY CONTROL) ---
            const sections = document.querySelectorAll('.content-section');
            const toggleSection = (section, header, content, icon, open) => {
                if (section.id === 'ai-unlocked-podcast') return;
                const isCollapsed = section.classList.contains('collapsed');
                
                const shouldOpen = (open !== undefined) ? open : isCollapsed;
                
                if (shouldOpen) {
                    section.classList.remove('collapsed');
                    if (icon) icon.textContent = '−'; 
                    // CRITICAL JS FIX: Explicitly set display for visibility
                    if (content) content.style.display = 'block'; 
                } else {
                    section.classList.add('collapsed');
                    if (icon) icon.textContent = '+'; 
                    // CRITICAL JS FIX: Explicitly set display to none to hide the button
                    if (content) content.style.display = 'none';
                }
            };


            // --- 1. Collapsible Sections Initial Setup & Click Listener (FIXED) ---
            sections.forEach(section => {
                const header = section.querySelector('.section-header');
                const content = section.querySelector('.section-content');
                const icon = section.querySelector('.icon');
                const defaultState = header.dataset.defaultState; 

                // Determine if this is a top-level grouping section that should always be open
                const isTopLevelGroup = (section.id === 'ai-unlocked-podcast' || section.id === 'enterprise-ai-resources' || section.id === 'legal-team-resources');
                
                if (isTopLevelGroup) {
                    section.classList.remove('collapsed');
                    if (content) content.style.display = 'block'; 
                    return;
                }

                // Initial setup for other sections (sub-sections)
                setTimeout(() => {
                    const shouldOpen = defaultState === 'open';
                    if (!shouldOpen) {
                        section.classList.add('collapsed');
                        if (icon) icon.textContent = '+';
                        if (content) content.style.display = 'none';
                    } else {
                        section.classList.remove('collapsed');
                        if (icon) icon.textContent = '−'; 
                        if (content) content.style.display = 'block';
                    }
                    
                }, 50);

                header.addEventListener('click', () => {
                    toggleSection(section, header, content, icon);
                });
            });
            
            // --- 2. RELIABLE ANCHOR / SCROLL & OPEN HANDLER (Updated to use simplified top nav links) ---
            document.querySelectorAll('.sidenav a[href^="#"], #fixed-top-nav a[href^="#"], .nav-dropdown-content a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    const href = this.getAttribute('href');
                    const targetId = href.substring(1);
                    
                    if (href.length > 1 && href.startsWith('#')) {
                        e.preventDefault();
                        const targetElement = document.querySelector(href);
                        
                        if (targetElement) {
                            
                            // 1. SCROLL TO SECTION
                            targetElement.scrollIntoView({
                                behavior: 'smooth',
                                block: 'start'
                            });

                            // 2. OPEN THE SECTION
                            const sectionToOpen = document.getElementById(targetId);
                            if (sectionToOpen && sectionToOpen.classList.contains('content-section')) {
                                const isCollapsed = sectionToOpen.classList.contains('collapsed');
                                
                                if (isCollapsed) {
                                    const header = sectionToOpen.querySelector('.section-header');
                                    const content = sectionToOpen.querySelector('.section-content');
                                    const icon = sectionToOpen.querySelector('.icon');
                                    
                                    toggleSection(sectionToOpen, header, content, icon, true); // Force open
                                }
                            }
                        }
                    }
                });
            });


            // --- 3. Synchronized & Dynamic Search Filtering (Fixed for robust search) ---
            const searchInputs = document.querySelectorAll('#desktop-search-input, #mobile-search-input');
            const cardsAndRows = document.querySelectorAll('.card, .ai-tool-card, .slack-list li, .responsive-table tbody tr');
            
            const filterContent = (searchTerm) => {
                const query = searchTerm.toLowerCase().trim();
                const allSections = document.querySelectorAll('.content-section');

                if (!query) {
                     allSections.forEach(section => {
                        const header = section.querySelector('.section-header');
                        const content = section.querySelector('.section-content');
                        const icon = section.querySelector('.icon');
                        const defaultState = header.dataset.defaultState; 

                        if (section.id !== 'ai-unlocked-podcast' && section.id !== 'enterprise-ai-resources' && section.id !== 'legal-team-resources') {
                            const shouldOpen = defaultState === 'open';
                            if (!shouldOpen) {
                                section.classList.add('collapsed');
                                if (icon) icon.textContent = '+';
                                if (content) content.style.display = 'none';
                            } else {
                                section.classList.remove('collapsed');
                                if (icon) icon.textContent = '−';
                                if (content) content.style.display = 'block';
                            }
                        }

                    });
                    
                    cardsAndRows.forEach(item => {
                        item.style.display = 'flex';
                    });
                    
                    return;
                }

                let sectionsToOpen = new Set();
                
                cardsAndRows.forEach(item => {
                    let content = '';
                    let itemDisplay = 'none';
                    
                    if (item.classList.contains('card') || item.classList.contains('ai-tool-card')) {
                        const searchData = item.dataset ? item.dataset.searchTerm || '' : ''; 
                        const cardBodyText = item.textContent || '';
                        content = (searchData + ' ' + cardBodyText).toLowerCase();

                        if (content.includes(query)) {
                            itemDisplay = 'flex'; 
                            let parentSection = item.closest('.content-section');
                            if (parentSection) {
                                sectionsToOpen.add(parentSection.id);
                            }
                        }
                    }
                    
                    item.style.display = itemDisplay;
                });
                
                allSections.forEach(section => {
                    const header = section.querySelector('.section-header');
                    const content = section.querySelector('.section-content');
                    const icon = section.querySelector('.icon');
                    
                    if (section.id === 'ai-unlocked-podcast' || section.id === 'enterprise-ai-resources' || section.id === 'legal-team-resources') return;
                    
                    if (sectionsToOpen.has(section.id)) {
                        section.classList.remove('collapsed');
                        if (icon) icon.textContent = '−'; 
                        if (content) content.style.display = 'block';
                    } else {
                        section.classList.add('collapsed');
                        if (icon) icon.textContent = '+'; 
                        if (content) content.style.display = 'none';
                    }
                });
            };

            searchInputs.forEach(input => {
                input.addEventListener('input', (e) => {
                    const searchTerm = e.target.value;
                    searchInputs.forEach(otherInput => {
                        if (otherInput !== e.target) {
                            otherInput.value = searchTerm;
                        }
                    });
                    filterContent(searchTerm);
                });
            });
            
            // --- NEW: Scroll to Top Button Handler ---
            document.querySelectorAll('.back-to-top-scroll').forEach(button => {
                button.addEventListener('click', function(e) {
                    e.preventDefault();
                    const homeAnchor = document.getElementById('home');
                    if (homeAnchor) {
                        homeAnchor.scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });
                    }
                });
            });
        });
    </script>
</body>
</html>
