    <script>
        // Initialize Lucide Icons
        lucide.createIcons();

        // Sidebar Toggle for Mobile
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('mobile-overlay');
            
            if (sidebar.classList.contains('-translate-x-full')) {
                sidebar.classList.remove('-translate-x-full');
                overlay.classList.remove('hidden');
            } else {
                sidebar.classList.add('-translate-x-full');
                overlay.classList.add('hidden');
            }
        }

        // Submenu Toggle
        function toggleSubmenu(menuId, chevronId) {
            const menu = document.getElementById(menuId);
            const chevron = document.getElementById(chevronId);
            
            if (menu.classList.contains('open')) {
                menu.classList.remove('open');
                chevron.classList.remove('rotate-chevron');
            } else {
                menu.classList.add('open');
                chevron.classList.add('rotate-chevron');
            }
        }

        // --- TAB LOGIC FOR TEAM NEWS SECTION ---
        function switchNewsTab(tabName, event) {
            if(event) event.preventDefault();

            const newsTabs = ['content-initiatives', 'content-spotlight', 'content-awards'];
            newsTabs.forEach(id => document.getElementById(id).classList.add('hidden'));

            const newsButtons = ['tab-initiatives', 'tab-spotlight', 'tab-awards'];
            newsButtons.forEach(id => {
                const btn = document.getElementById(id);
                btn.classList.remove('active', 'text-procore-600');
                btn.classList.add('text-gray-500');
            });

            document.getElementById(`content-${tabName}`).classList.remove('hidden');
            const activeBtn = document.getElementById(`tab-${tabName}`);
            activeBtn.classList.add('active', 'text-procore-600');
            activeBtn.classList.remove('text-gray-500');
        }

        // --- TAB LOGIC FOR HARVEY SECTION ---
        function switchHarveyTab(tabName, event) {
            if(event) event.preventDefault();

            const harveyTabs = ['content-harvey'];
            harveyTabs.forEach(id => document.getElementById(id).classList.add('hidden'));

            const harveyButtons = ['tab-harvey'];
            harveyButtons.forEach(id => {
                const btn = document.getElementById(id);
                if (btn) {
                    btn.classList.remove('active', 'text-procore-600');
                    btn.classList.add('text-gray-500');
                }
            });

            document.getElementById(`content-${tabName}`).classList.remove('hidden');
            const activeBtn = document.getElementById(`tab-${tabName}`);
            activeBtn.classList.add('active', 'text-procore-600');
            activeBtn.classList.remove('text-gray-500');
        }

        // --- TAB LOGIC FOR LEARNING CENTER SECTION ---
        function switchLearningTab(tabName, event) {
            if(event) event.preventDefault();

            const learningTabs = ['content-learning-dev', 'content-enterprise-tools'];
            learningTabs.forEach(id => {
                const el = document.getElementById(id);
                if (el) el.classList.add('hidden');
            });

            const learningButtons = ['tab-learning-dev', 'tab-enterprise-tools'];
            learningButtons.forEach(id => {
                const btn = document.getElementById(id);
                if (btn) {
                    btn.classList.remove('active', 'text-procore-600');
                    btn.classList.add('text-gray-500');
                }
            });

            const contentEl = document.getElementById(`content-${tabName}`);
            if (contentEl) contentEl.classList.remove('hidden');
            
            const activeBtn = document.getElementById(`tab-${tabName}`);
            if (activeBtn) {
                activeBtn.classList.add('active', 'text-procore-600');
                activeBtn.classList.remove('text-gray-500');
            }
        }

        // --- TAB LOGIC FOR INNOVATION CENTER SECTION (NEW) ---
        function switchInnovationTab(tabName, event) {
            if(event) event.preventDefault();

            const innovationTabs = ['content-workstreams', 'content-tech-stack', 'content-trends'];
            innovationTabs.forEach(id => document.getElementById(id).classList.add('hidden'));

            const innovationButtons = ['tab-workstreams', 'tab-tech-stack', 'tab-trends'];
            innovationButtons.forEach(id => {
                const btn = document.getElementById(id);
                btn.classList.remove('active', 'text-procore-600');
                btn.classList.add('text-gray-500');
            });

            document.getElementById(`content-${tabName}`).classList.remove('hidden');
            const activeBtn = document.getElementById(`tab-${tabName}`);
            activeBtn.classList.add('active', 'text-procore-600');
            activeBtn.classList.remove('text-gray-500');
        }

        // --- GENERAL SCROLL HANDLER (Used by Sidebar) ---
        function scrollToSection(targetName, event) {
            if(event) event.preventDefault();

            const newsGroup = ['initiatives', 'spotlight', 'awards'];
            const harveyGroup = ['harvey'];
            const learningGroup = ['learning-dev', 'enterprise-tools'];
            const innovationGroup = ['workstreams', 'tech-stack', 'trends'];

            if (targetName === 'ai-core') {
                const el = document.getElementById('ai-core');
                if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
            } else if (newsGroup.includes(targetName)) {
                switchNewsTab(targetName);
                document.getElementById('section-team-news').scrollIntoView({ behavior: 'smooth', block: 'start' });
            } else if (harveyGroup.includes(targetName)) {
                switchHarveyTab(targetName);
                document.getElementById('section-harvey-center').scrollIntoView({ behavior: 'smooth', block: 'start' });
            } else if (learningGroup.includes(targetName)) {
                switchLearningTab(targetName);
                document.getElementById('section-learning-center').scrollIntoView({ behavior: 'smooth', block: 'start' });
            } else if (innovationGroup.includes(targetName)) {
                switchInnovationTab(targetName);
                document.getElementById('section-innovation-center').scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }

        // NEW: Toggle interview function
        function toggleInterview() {
            const content = document.getElementById('interview-content');
            if (content.classList.contains('hidden')) {
                content.classList.remove('hidden');
            } else {
                content.classList.add('hidden');
            }
        }

        // --- VIDEO MODAL LOGIC ---
        function openVideoModal(videoId) {
            const modal = document.getElementById('video-modal');
            const iframe = document.getElementById('modal-video-iframe');
            
            // Set source with autoplay
            iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1`;
            
            // Show modal
            modal.classList.add('active');
            
            // Prevent background scrolling
            document.body.style.overflow = 'hidden';
        }

        function closeVideoModal() {
            const modal = document.getElementById('video-modal');
            const iframe = document.getElementById('modal-video-iframe');
            
            // Clear source to stop video
            iframe.src = '';
            
            // Hide modal
            modal.classList.remove('active');
            
            // Restore scrolling
            document.body.style.overflow = '';
        }
    </script>
